---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorkIndex from '../components/WorkIndex.astro';
import Spatial from '../components/Spatial.astro';
import { getItems } from '../lib/content';

const work = await getItems('work');
const experiments = await getItems('experiments');
---

<Base page="home">
  <Spatial items={[...work, ...experiments]} slot="full" />
  <div class="home">
    <div class="left"><Hero /></div>
    <WorkIndex work={work} />
  </div>
</Base>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 96px);
    padding-top: clamp(24px, 8vh, 96px);
    align-items: start;
  }
  .left { position: sticky; top: calc(var(--header-h) + clamp(24px, 8vh, 96px)); }
  @media (max-width: 960px) {
    .home { grid-template-columns: minmax(0, 1fr); padding-top: 24px; }
    .left { position: static; }
  }
  :global(body.spatial-on) { overflow: hidden; }
  :global(body.spatial-on .page) { display: none; }
</style>

<script>
  // The saved grid / list choice is applied as the new page is swapped in, before it is first painted,
  // so coming back never flashes the wrong layout (or changes height under the restored scroll).
  function restoreLayout() {
    let saved = '';
    try { saved = localStorage.getItem('layout') || ''; } catch {}
    const grid = document.querySelector<HTMLElement>('.home .grid');
    const list = document.querySelector<HTMLElement>('.home .list');
    if (!grid || !list || saved !== 'list') return;
    grid.hidden = true;
    list.hidden = false;
    document.querySelectorAll<HTMLButtonElement>('.home [data-layout]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.layout === 'list')));
  }
  document.addEventListener('astro:after-swap', restoreLayout);

  // Discipline chips filter the work: matching projects light up. Click a chip to pin it.
  function init() {
    const home = document.querySelector('.home');
    if (!home) return;
    const cards = [...home.querySelectorAll<HTMLElement>('.card, .lrow')];
    const chips = [...home.querySelectorAll<HTMLButtonElement>('.chip')];
    let pinned = '';

    const keysOf = (el: HTMLElement, attr: string) => (el.getAttribute(attr) || '').split(' ').filter(Boolean);

    function pin(key: string) {
      pinned = pinned === key ? '' : key;
      chips.forEach((c) => c.setAttribute('aria-pressed', String((c.dataset.filter || '') === pinned)));
      home!.classList.toggle('hl-active', !!pinned);
      cards.forEach((c) => c.classList.toggle('lit', !!pinned && keysOf(c, 'data-disc').includes(pinned)));
    }

    // "All" clears the pin (pinning the current key again toggles it off)
    chips.forEach((c) => c.addEventListener('click', () => pin(c.dataset.filter || pinned)));

    // Grid / list layout
    const grid = home.querySelector<HTMLElement>('.grid')!;
    const list = home.querySelector<HTMLElement>('.list')!;
    const btns = [...home.querySelectorAll<HTMLButtonElement>('[data-layout]')];
    function setLayout(l: string) {
      grid.hidden = l === 'list';
      list.hidden = l !== 'list';
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.layout === l)));
      try { localStorage.setItem('layout', l); } catch {}
      document.dispatchEvent(new CustomEvent('view-change'));
    }
    btns.forEach((b) => b.addEventListener('click', () => setLayout(b.dataset.layout!)));
    try { if (localStorage.getItem('layout') === 'list') setLayout('list'); } catch {}

    // Floating preview for list rows
    const preview = home.querySelector<HTMLElement>('.preview')!;
    list.querySelectorAll<HTMLElement>('.lrow').forEach((row, i) => {
      row.addEventListener('pointerenter', () => {
        if (row.dataset.preview) preview.style.backgroundImage = `url("${row.dataset.preview}")`;
        preview.style.setProperty('--rot', (i % 2 ? 2 : -2) + 'deg');
        preview.classList.add('show');
      });
      row.addEventListener('pointerleave', () => preview.classList.remove('show'));
    });
    const hide = () => preview.classList.remove('show');
    list.addEventListener('pointerleave', hide);
    window.addEventListener('scroll', hide, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', hide), { once: true });
    list.addEventListener('pointermove', (e) => {
      preview.style.setProperty('--px', e.clientX + 24 + 'px');
      preview.style.setProperty('--py', e.clientY - 90 + 'px');
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
