---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="nf">
    <p class="label">404</p>
    <h1>This page wandered off.</h1>
    <a href="/" class="u">Back to the work →</a>
  </div>
</Base>

<style>
  .nf { padding-top: 20vh; }
  h1 { font-size: clamp(36px, 5vw, 72px); letter-spacing: -0.045em; font-weight: 450; margin: 12px 0 24px; }
</style>
