---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Thinking from '../components/Thinking.astro';
import Modals from '../components/Modals.astro';
import Loader from '../components/Loader.astro';
import { getSite } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  page?: 'home' | 'work' | 'experiments' | 'info' | 'other';
}
const site = await getSite();
const { title, description = `${site.data.name} — ${site.data.role}.`, image, page = 'other' } = Astro.props;
const fullTitle = title ? `${title} — ${site.data.name}` : `${site.data.name} · ${site.data.role}`;
const ogImage = image ? new URL(image, Astro.site).href : undefined;

// Page content: a quick fade out, then a calm fade in
const calm = {
  old: { name: 'page-out', duration: '150ms', easing: 'ease-out', fillMode: 'both' },
  new: { name: 'page-in', duration: '300ms', easing: 'cubic-bezier(0.2, 0.7, 0.1, 1)', delay: '60ms', fillMode: 'both' },
};
const calmAnim = { forwards: calm, backwards: calm };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    <script is:inline>
      function applyTheme() {
        try { if (sessionStorage.getItem('theme') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); else document.documentElement.removeAttribute('data-theme'); } catch {}
        try { document.documentElement.classList.toggle('thinking', localStorage.getItem('thinking') === '1'); } catch {}
      }
      try { localStorage.removeItem('theme'); } catch {}
      // first load of a visit: show the intro curtain (not for reduced motion)
      try { if (!sessionStorage.getItem('loaded') && !matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('has-loader'); } catch {}
      applyTheme();
      document.documentElement.classList.add('js');
      // a swap replaces <html>'s attributes, so restore them; "nav" marks every page after the first
      document.addEventListener('astro:after-swap', () => { applyTheme(); document.documentElement.classList.add('nav', 'js'); });
    </script>
  </head>
  <body data-page={page}>
    <Loader name={site.data.name} />
    <Header page={page} />
    <slot name="full" />
    <div class="page">
      <main id="main" transition:name="page" transition:animate={calmAnim}>
        <slot />
      </main>
      <Footer />
    </div>
    <Thinking />
    <Modals />
    <script>
      // Hold the swap (briefly) until the case study's hero image is decoded,
      // so the card morphs into a picture rather than a blank frame.
      document.addEventListener('astro:before-preparation', (e) => {
        const load = e.loader;
        e.loader = async () => {
          await load();
          const img = e.newDocument?.querySelector<HTMLImageElement>('[data-hero] img');
          if (!img) return;
          const pre = new Image();
          pre.sizes = img.sizes;
          pre.srcset = img.srcset;
          pre.src = img.src;
          await Promise.race([pre.decode().catch(() => {}), new Promise((r) => setTimeout(r, 600))]);
        };
      });
    </script>
  </body>
</html>
