---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Thinking from '../components/Thinking.astro';
import Modals from '../components/Modals.astro';
import Loader from '../components/Loader.astro';
import { getSite } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  page?: 'home' | 'work' | 'experiments' | 'info' | 'other';
}
const site = await getSite();
const { title, description = `${site.data.name} — ${site.data.role}.`, image, page = 'other' } = Astro.props;
const fullTitle = title ? `${title} — ${site.data.name}` : `${site.data.name} · ${site.data.role}`;
const ogImage = image ? new URL(image, Astro.site).href : undefined;

// Page content: a quick fade out, then a calm fade in
const calm = {
  old: { name: 'page-out', duration: '180ms', easing: 'ease-out', fillMode: 'both' },
  new: { name: 'page-in', duration: '320ms', easing: 'cubic-bezier(0.2, 0.7, 0.1, 1)', delay: '60ms', fillMode: 'both' },
};
const calmAnim = { forwards: calm, backwards: calm };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter />
    <script is:inline>
      function applyTheme() {
        try { if (sessionStorage.getItem('theme') === 'dark') document.documentElement.setAttribute('data-theme', 'dark'); else document.documentElement.removeAttribute('data-theme'); } catch {}
        try { document.documentElement.classList.toggle('thinking', localStorage.getItem('thinking') === '1'); } catch {}
      }
      try { localStorage.removeItem('theme'); } catch {}
      // every full document load (first visit, new tab, reload) plays the intro; soft navigations don't re-run this
      try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('has-loader'); } catch {}
      applyTheme();
      document.documentElement.classList.add('js');
      // a swap replaces <html>'s attributes, so restore them; "nav" marks every page after the first
      document.addEventListener('astro:after-swap', () => { applyTheme(); document.documentElement.classList.add('nav', 'js'); });
    </script>
  </head>
  <body data-page={page}>
    <Loader name={site.data.name} />
    <Header page={page} />
    <slot name="full" />
    <div class="page">
      <main id="main" transition:name="page" transition:animate={calmAnim}>
        <slot />
      </main>
      <Footer />
    </div>
    <Thinking />
    <Modals />
    <script>
      // Hold the swap (briefly) until the image the morph lands on is decoded, in either direction:
      // going in it is the case study's hero, coming back it is the card of the project we just left.
      // That way the frame always morphs into a picture, never a blank placeholder.
      document.addEventListener('astro:before-preparation', (e) => {
        const load = e.loader;
        e.loader = async () => {
          await load();
          const next = e.newDocument;
          const left = document.querySelector<HTMLElement>('[data-hero]')?.style.viewTransitionName;
          const img =
            next?.querySelector<HTMLImageElement>('[data-hero] img') ??
            (left ? [...(next?.querySelectorAll<HTMLElement>('.card .media') ?? [])].find((m) => m.style.viewTransitionName === left)?.querySelector<HTMLImageElement>('img.cover') : undefined);
          // a beat for the clicked card to settle (ring, zoom) so the morph starts from a clean frame
          const settle = document.querySelector('.card.leaving') ? new Promise((r) => setTimeout(r, 140)) : Promise.resolve();
          const ready = img
            ? (() => { const pre = new Image(); pre.sizes = img.sizes; pre.srcset = img.srcset; pre.src = img.src; return pre.decode().catch(() => {}); })()
            : Promise.resolve();
          await Promise.all([settle, Promise.race([ready, new Promise((r) => setTimeout(r, 450))])]);
        };
      });

      // Remember which path sits at each history index, so "Back to index" knows whether stepping back really lands on the home page.
      const remember = () => {
        try {
          const i = history.state?.index;
          if (typeof i !== 'number') return;
          const map = JSON.parse(sessionStorage.getItem('trail') || '{}');
          map[i] = location.pathname;
          sessionStorage.setItem('trail', JSON.stringify(map));
        } catch {}
      };
      document.addEventListener('astro:page-load', remember);

      // The persistent-looking chrome is rebuilt on every swap; hand the new copy the old state so nothing blips.
      document.addEventListener('astro:before-swap', (e) => {
        const next = e.newDocument;
        const from = document.querySelector<HTMLElement>('.views');
        const to = next.querySelector<HTMLElement>('.views');
        if (from && to) ['--o', '--w', '--x'].forEach((k) => { const v = from.style.getPropertyValue(k); if (v) to.style.setProperty(k, v); });
        const clock = document.querySelector('.clock');
        const nextClock = next.querySelector('.clock');
        if (clock && nextClock) nextClock.textContent = clock.textContent;
      });
    </script>
  </body>
</html>
