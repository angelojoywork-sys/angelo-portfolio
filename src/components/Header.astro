---
import { getSite } from '../lib/content';
interface Props { page: string }
const { page } = Astro.props;
const site = await getSite();
const isHome = page === 'home';
const showThinking = page === 'home' || page === 'experiments';
---

<header class="site-header" transition:name="site-header" transition:animate="none">
  <a href="/" class="brand" aria-label={`${site.data.name}, home`}>
    <span class="brand-name" aria-hidden="true"><span class="brand-init">{site.data.name.charAt(0)}</span><span class="brand-rest">{site.data.name.slice(1)}</span></span>
  </a>

  <nav class="views" aria-label="Work views">
    <a href={isHome ? '#index' : '/#index'} data-view="index" class="seg">Index</a>
    <a href={isHome ? '#spatial' : '/#spatial'} data-view="spatial" class="seg">Spatial</a>
    <span class="seg-thumb" aria-hidden="true"></span>
  </nav>

  <nav class="links" aria-label="Main">
    <a href="/experiments/" class:list={['nav-link', { active: page === 'experiments' }]}>Experiments</a>
    <button type="button" class="nav-link" data-modal="about">About</button>
    <button type="button" class="nav-link" data-modal="contact">Contact</button>
    <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Switch to dark theme" title="Switch theme">
      <svg class="sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
      <svg class="moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
    </button>
    {showThinking && <button class="think-toggle" type="button" aria-pressed="false" title="Reveal my thinking (T)">
      <span class="switch" aria-hidden="true"><span></span></span>
      <span class="think-label">Reveal my thinking</span>
      <kbd>T</kbd>
    </button>}
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--header-h);
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 var(--gutter);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
  }
  .brand { display: inline-flex; align-items: center; font-weight: 550; letter-spacing: -0.01em; justify-self: start; }

  .views {
    position: relative;
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 13px;
  }
  .seg { position: relative; z-index: 1; padding: 5px 16px; border-radius: 999px; color: var(--muted); transition: color var(--dur-1); }
  .seg:hover { color: var(--fg); }
  .seg.active { color: var(--fg); }
  .seg-thumb {
    position: absolute; top: 3px; bottom: 3px; left: 3px;
    width: var(--w, 0px);
    transform: translateX(var(--x, 0px));
    border-radius: 999px;
    background: var(--raised);
    box-shadow: var(--shadow);
    transition: transform var(--dur-2) var(--ease), width var(--dur-2) var(--ease), opacity var(--dur-1);
    opacity: var(--o, 0);
  }

  .links { justify-self: end; display: inline-flex; align-items: center; gap: clamp(12px, 2vw, 28px); font-size: 14px; }
  .nav-link { position: relative; color: var(--fg); }
  .nav-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: -3px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform var(--dur-2) var(--ease); }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); transform-origin: left; }
  .nav-link::after { background: var(--hover); box-shadow: 0 0 8px var(--accent-glow); }

  button.nav-link { font: inherit; font-size: 14px; padding: 0; }

  /* Name: the loader's "A" lands on the initial, then the rest rises in behind it. */
  .brand-name { display: inline-block; line-height: 1.5; }
  .brand-init, .brand-rest { display: inline-block; }
  /* while the intro plays the brand waits; the loader hands over and clears has-loader */
  :global(html.has-loader) .brand-name { opacity: 0; }
  :global(html.has-loader.loader-rest) .brand-name { opacity: 1; }
  :global(html.has-loader.loader-rest) .brand-init { visibility: hidden; }
  :global(html.loader-rest) .brand-rest { animation: name-rise var(--dur-3) var(--ease) backwards; }
  @keyframes name-rise { from { opacity: 0; transform: translateY(6px); } }

  .theme-toggle { position: relative; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; color: var(--fg); transition: background var(--dur-1); }
  .theme-toggle:hover { background: var(--surface); }
  .theme-toggle svg { grid-area: 1 / 1; transition: transform var(--dur-3) var(--ease), opacity var(--dur-2); }
  .theme-toggle .moon { opacity: 0; transform: rotate(-90deg) scale(.5); }
  :global(:root[data-theme='dark']) .theme-toggle .sun { opacity: 0; transform: rotate(90deg) scale(.5); }
  :global(:root[data-theme='dark']) .theme-toggle .moon { opacity: 1; transform: none; }

  /* Spatial owns the whole screen, so the thinking overlay steps aside */
  :global(body.spatial-on) .think-toggle { display: none; }
  :global(body.spatial-on .th-grid), :global(body.spatial-on .th-gen) { display: none; }
  .think-toggle { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); padding: 5px 8px 5px 6px; border-radius: 999px; border: 1px solid var(--line); transition: border-color var(--dur-1), color var(--dur-1); }
  .think-toggle:hover { color: var(--fg); border-color: var(--faint); }
  .switch { width: 26px; height: 15px; border-radius: 999px; background: var(--line); position: relative; transition: background var(--dur-1); }
  .switch span { position: absolute; top: 2px; left: 2px; width: 11px; height: 11px; border-radius: 50%; background: var(--bg); box-shadow: 0 1px 2px rgb(0 0 0 / .25); transition: transform var(--dur-2) var(--ease); }
  :global(html.thinking) .switch { background: var(--accent); }
  :global(html.thinking) .switch span { transform: translateX(11px); }
  :global(html.thinking) .think-toggle { color: var(--fg); }
  kbd { font-family: var(--mono); font-size: 10px; border: 1px solid var(--line); border-radius: 4px; padding: 0 4px; color: var(--faint); }

  @media (max-width: 900px) {
    .think-label, kbd { display: none; }
    .think-toggle { padding: 6px; }
  }
  @media (max-width: 720px) {
    /* backdrop-filter would trap the fixed pill inside the header, so use a solid bar */
    .site-header { grid-template-columns: 1fr auto; backdrop-filter: none; -webkit-backdrop-filter: none; background: color-mix(in srgb, var(--bg) 96%, transparent); }
    .brand-name { font-size: 14px; }
    .links { gap: 14px; }
    .nav-link { font-size: 14px; }
    .think-toggle { display: none; }
    /* Index / Spatial switch becomes a floating pill at the bottom on phones */
    .views { position: fixed; left: 50%; bottom: max(16px, env(safe-area-inset-bottom)); transform: translateX(-50%); box-shadow: var(--shadow); background: color-mix(in srgb, var(--surface) 92%, transparent); backdrop-filter: blur(10px); }
    :global(body:not([data-page='home'])) .views { display: none; }
  }
</style>

<script>
  function setThinking(on: boolean) {
    document.documentElement.classList.toggle('thinking', on);
    try { localStorage.setItem('thinking', on ? '1' : '0'); } catch {}
    document.querySelectorAll('.think-toggle').forEach((b) => b.setAttribute('aria-pressed', String(on)));
    document.dispatchEvent(new CustomEvent('thinking-change', { detail: on }));
  }

  function syncTheme() {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.querySelectorAll('.theme-toggle').forEach((b) => {
      b.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
      b.setAttribute('aria-pressed', String(dark));
    });
  }

  function syncViews() {
    syncTheme();
    const nav = document.querySelector<HTMLElement>('.views');
    if (!nav) return;
    const isHome = document.body.dataset.page === 'home';
    const view = isHome ? (location.hash === '#spatial' ? 'spatial' : 'index') : null;
    let active: HTMLElement | null = null;
    nav.querySelectorAll<HTMLAnchorElement>('.seg').forEach((a) => {
      const on = a.dataset.view === view;
      a.classList.toggle('active', on);
      a.href = (isHome ? '' : '/') + '#' + a.dataset.view;
      if (on) active = a;
    });
    const el = active as HTMLElement | null;
    nav.style.setProperty('--o', el ? '1' : '0');
    if (el) {
      nav.style.setProperty('--w', el.offsetWidth + 'px');
      nav.style.setProperty('--x', el.offsetLeft - 3 + 'px');
    }
    document.querySelectorAll('.think-toggle').forEach((b) =>
      b.setAttribute('aria-pressed', String(document.documentElement.classList.contains('thinking')))
    );
  }

  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.theme-toggle')) {
      const dark = document.documentElement.getAttribute('data-theme') !== 'dark';
      if (dark) document.documentElement.setAttribute('data-theme', 'dark');
      else document.documentElement.removeAttribute('data-theme');
      try { sessionStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      syncTheme();
      return;
    }
    const t = (e.target as HTMLElement).closest('.think-toggle');
    if (t) setThinking(!document.documentElement.classList.contains('thinking'));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() !== 't' || e.metaKey || e.ctrlKey || e.altKey) return;
    if (document.body.classList.contains('spatial-on')) return;
    if (!document.querySelector('.think-toggle')) return;
    const tag = (e.target as HTMLElement).tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    setThinking(!document.documentElement.classList.contains('thinking'));
  });
  // Astro's router swallows same-page "#" links without firing hashchange,
  // so on the home page handle the Index / Spatial switch ourselves.
  window.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.views .seg');
    if (!a || document.body.dataset.page !== 'home') return;
    e.preventDefault();
    e.stopPropagation();
    const hash = '#' + a.dataset.view;
    if (location.hash !== hash) history.pushState(history.state, '', hash);
    window.dispatchEvent(new HashChangeEvent('hashchange'));
  }, true);
  window.addEventListener('popstate', () => {
    if (document.body.dataset.page === 'home') window.dispatchEvent(new HashChangeEvent('hashchange'));
  });
  window.addEventListener('hashchange', syncViews);
  window.addEventListener('resize', syncViews);
  document.addEventListener('astro:page-load', syncViews);
  document.fonts?.ready.then(syncViews);
</script>
