---
import { getImage } from 'astro:assets';
import { getSite, type Item } from '../lib/content';
interface Props { items: Item[] }
const { items } = Astro.props;
const site = await getSite();

// Each project contributes its cover plus a couple of gallery images as nodes.
const nodes = [];
for (const it of items) {
  const imgs = [it.cover, ...it.gallery].filter((m) => m?.kind === 'image').slice(0, it.kind === 'work' ? 3 : 2);
  for (const m of imgs) {
    if (m?.kind !== 'image') continue;
    // small source for the globe, a sharp one swapped in when a node is shown large
    const [img, hi] = await Promise.all([
      getImage({ src: m.image, width: 480, format: 'webp' }),
      getImage({ src: m.image, width: Math.min(1600, m.image.width), format: 'webp', quality: 80 }),
    ]);
    nodes.push({
      src: img.src,
      hi: hi.src,
      ar: m.image.width / m.image.height,
      slug: `${it.kind}/${it.slug}`,
      url: it.url,
      title: it.data.title,
      type: it.data.type ?? '',
      kind: it.kind,
      disc: it.data.disciplines,
    });
  }
}
const legend = Object.entries(site.data.disciplines)
  .map(([k, v]) => ({ k, v, n: items.filter((i) => i.data.disciplines.includes(k)).length }))
  .filter((l) => l.n > 0);
---

<section class="spatial" aria-label="Spatial view of all work" hidden>
  <div class="stage" tabindex="0" aria-label="Drag or use arrow keys to rotate, scroll or press plus and minus to immerse">
    <svg class="lines" aria-hidden="true"><g class="orbits"></g><g class="links"></g></svg>
    <div class="nodes"></div>
    <div class="tip" aria-hidden="true"><b></b><span></span></div>
  </div>

  <p class="hint label"><span class="touch">Drag to rotate · pinch to immerse · tap to open</span></p>

  <div class="caption">
    <h1 class="stitle">{site.data.spatialTitle}</h1>
    <p class="sub fine">Scroll to immerse</p>
  </div>

  <div class="fcap">
    <p class="fc-meta label"><span class="fc-count"></span><span class="fc-type"></span></p>
    <h2 class="fc-title"></h2>
    <a class="fc-open" href="/" tabindex="-1">Open project <span aria-hidden="true">→</span></a>
    <p class="fc-hint label"><span class="fine">Drag sideways to browse · up/down to zoom out</span><span class="touch">Swipe to browse</span></p>
  </div>
  <p class="visually-hidden fc-live" aria-live="polite"></p>

  <ul class="legend" aria-label="Disciplines">
    {legend.map((l) => <li><button type="button" data-k={l.k}><span class="sw"></span>{l.v}<span class="label">{String(l.n).padStart(2, '0')}</span></button></li>)}
  </ul>

  <div class="ruler" role="slider" tabindex="0" aria-label="Immerse" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div class="ruler-track">
      {Array.from({ length: 28 }, () => <i></i>)}
      <span class="ruler-fill"></span>
      <span class="ruler-mark"><em class="label">Immerse</em></span>
    </div>
  </div>

  <script type="application/json" class="spatial-data" set:html={JSON.stringify(nodes)} />
</section>

<style>
  .spatial { position: fixed; inset: 0; z-index: 10; background: var(--bg); overflow: hidden; touch-action: none; --imm: 0; }
  .spatial[hidden] { display: none; }
  /* soft vignette that deepens as you fly into the globe */
  .spatial::after { content: ''; position: absolute; inset: 0; z-index: 1500; pointer-events: none; opacity: var(--imm); background: radial-gradient(ellipse 75% 70% at 50% 46%, transparent 40%, color-mix(in srgb, var(--bg) 88%, transparent) 100%); }
  .stage { position: absolute; inset: 0; cursor: grab; outline: none; }
  .stage.dragging { cursor: grabbing; }
  .lines { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .lines :global(.orbits) { transition: opacity var(--dur-2); }
  .lines :global(.orbits path) { fill: none; stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 4; }
  .lines :global(.links line) { stroke: var(--accent); stroke-width: 1; }
  .lines :global(.links line.weak) { stroke: var(--faint); stroke-dasharray: 3 3; }
  .nodes { position: absolute; inset: 0; }
  .nodes :global(a) {
    position: absolute; left: 0; top: 0; display: block;
    background: var(--surface) center / cover no-repeat;
    border-radius: 2px;
    will-change: transform, opacity;
    transition: filter var(--dur-2), box-shadow var(--dur-2);
  }
  .nodes :global(a.rel) { box-shadow: 0 0 0 1px var(--accent); }
  .nodes :global(a.dimmed) { filter: grayscale(1) opacity(0.2); }
  .nodes :global(a:focus-visible) { outline-offset: 2px; }
  .nodes :global(a.focus) { cursor: pointer; box-shadow: var(--shadow); }
  .spatial.focused .nodes :global(a:not(.focus)) { pointer-events: none; }

  .tip { position: absolute; left: 0; top: 0; pointer-events: none; background: var(--fg); color: var(--bg); padding: 7px 10px; border-radius: 6px; font-size: 13px; line-height: 1.25; opacity: 0; transition: opacity var(--dur-1); white-space: nowrap; z-index: 99999; }
  .tip b { display: block; font-family: var(--display); font-weight: 500; }
  .tip span { font: 10px var(--mono); opacity: .65; text-transform: uppercase; }
  .tip.show { opacity: 1; }

  .hint, .caption, .legend, .ruler { z-index: 2000; }
  .hint { position: absolute; bottom: clamp(24px, 5vh, 56px); left: 50%; transform: translateX(-50%); pointer-events: none; white-space: nowrap; transition: opacity var(--dur-3) var(--ease); }
  .spatial.used .hint, .spatial.zoomed .hint { opacity: 0; }
  .caption { position: absolute; left: var(--gutter); bottom: clamp(24px, 5vh, 56px); pointer-events: none; max-width: min(980px, 88vw); transition: opacity var(--dur-2) var(--ease), transform var(--dur-3) var(--ease); }
  .spatial.zoomed .caption { opacity: 0; transform: translateY(12px); }
  .stitle { margin: 0; font-size: clamp(28px, 3.4vw, 52px); line-height: 1; letter-spacing: -0.03em; font-family: var(--display); font-weight: 500; text-wrap: balance; }
  .sub { margin: 14px 0 0; color: var(--muted); }

  /* focus mode: one project fills the view, its caption replaces the headline */
  .fcap { position: absolute; left: var(--gutter); bottom: clamp(24px, 5vh, 56px); z-index: 2000; max-width: min(560px, 80vw); pointer-events: none; opacity: 0; transform: translateY(12px); transition: opacity var(--dur-2) var(--ease), transform var(--dur-3) var(--ease); }
  .spatial.focused .fcap { opacity: 1; transform: none; }
  .spatial.focused .fc-open { pointer-events: auto; }
  .fc-meta { display: flex; gap: 14px; margin: 0 0 10px; }
  .fc-count { color: var(--fg); font-variant-numeric: tabular-nums; }
  .fc-title { margin: 0; font-size: clamp(24px, 2.6vw, 40px); line-height: 1.05; letter-spacing: -0.025em; font-family: var(--display); font-weight: 500; text-wrap: balance; }
  .fc-title.in, .fc-meta.in { animation: fc-in var(--dur-3) var(--ease) both; }
  @keyframes fc-in { from { opacity: 0; transform: translateY(6px); } }
  .fc-open { display: inline-block; margin-top: 14px; font-size: 14px; padding-bottom: 2px; border-bottom: 1px solid currentColor; }
  .fc-open span { display: inline-block; transition: transform var(--dur-2) var(--ease); }
  .fc-open:hover span { transform: translateX(3px); }
  .fc-hint { margin: 18px 0 0; }

  .legend { position: absolute; right: var(--gutter); bottom: clamp(24px, 5vh, 56px); list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; align-items: flex-end; transition: opacity var(--dur-2) var(--ease); }
  .spatial.zoomed .legend { opacity: 0; pointer-events: none; }
  .legend button { display: inline-flex; gap: 8px; align-items: center; font-size: 13px; color: var(--muted); padding: 3px 0; transition: color var(--dur-1); }
  .legend button:hover, .legend button.on { color: var(--fg); }
  .legend .sw { width: 8px; height: 8px; border-radius: 50%; border: 1px solid currentColor; transition: background var(--dur-1); }
  .legend button:hover .sw, .legend button.on .sw { background: var(--accent); border-color: var(--accent); }

  /* the padding is an invisible, generous hit area around the ticks */
  .ruler { position: absolute; right: calc(var(--gutter) - 14px); top: 50%; transform: translateY(-50%); padding: 14px; cursor: ns-resize; touch-action: none; outline: none; }
  .ruler-track { position: relative; display: flex; flex-direction: column; gap: 6px; align-items: flex-end; }
  .ruler i { display: block; width: 8px; height: 1px; background: var(--line); }
  .ruler i:nth-child(7n + 1) { width: 14px; background: var(--faint); }
  .ruler-fill { position: absolute; right: 0; top: var(--zy, 100%); bottom: 0; width: 2px; background: var(--accent); }
  .ruler-mark { position: absolute; right: 0; top: var(--zy, 100%); width: 22px; height: 1px; background: var(--fg); transition: width var(--dur-1) var(--ease); }
  .ruler:hover .ruler-mark, .ruler.active .ruler-mark { width: 30px; }
  .ruler:focus-visible .ruler-mark { background: var(--accent); width: 30px; }
  .ruler-mark em { position: absolute; right: 38px; top: -6px; font-style: normal; transition: color var(--dur-1); }
  .ruler:hover .ruler-mark em, .ruler.active .ruler-mark em { color: var(--fg); }

  @media (prefers-reduced-motion: reduce) { .fc-title.in, .fc-meta.in { animation: none; } }
  .touch { display: none; }
  @media (hover: none) { .fine { display: none; } .touch { display: inline; } }
  @media (max-width: 720px) {
    .legend { display: none; }
    .hint { bottom: calc(76px + env(safe-area-inset-bottom)); }
    .spatial.filled .ruler { opacity: 0; pointer-events: none; }
    .ruler { transition: opacity var(--dur-2) var(--ease); }
    .ruler { right: 0; padding: 16px 10px 16px 28px; }
    .ruler-track { gap: 5px; }
    .ruler i { width: 6px; }
    .ruler i:nth-child(7n + 1) { width: 10px; }
    .ruler-mark { width: 16px; }
    .ruler-mark em { right: 22px; font-size: 10px; }
    .caption { bottom: calc(112px + env(safe-area-inset-bottom)); max-width: none; right: var(--gutter); }
    .stitle { font-size: clamp(20px, 5.6vw, 24px); line-height: 1.12; }
    .fcap { bottom: calc(76px + env(safe-area-inset-bottom)); }
  }
</style>

<script>
  import { navigate } from 'astro:transitions/client';

  type Node = { src: string; hi: string; ar: number; slug: string; url: string; title: string; type: string; kind: string; disc: string[] };

  let stop: (() => void) | null = null;

  const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  function mount(root: HTMLElement) {
    const data: Node[] = JSON.parse(root.querySelector('.spatial-data')!.textContent || '[]');
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const layer = root.querySelector<HTMLElement>('.nodes')!;
    const links = root.querySelector<SVGGElement>('.links')!;
    const orbits = root.querySelector<SVGGElement>('.orbits')!;
    const tip = root.querySelector<HTMLElement>('.tip')!;
    const ruler = root.querySelector<HTMLElement>('.ruler')!;
    const track = root.querySelector<HTMLElement>('.ruler-track')!;
    const caption = root.querySelector<HTMLElement>('.caption')!;
    const title = root.querySelector<HTMLElement>('.stitle')!;
    const fcap = root.querySelector<HTMLElement>('.fcap')!;
    const fcMeta = fcap.querySelector<HTMLElement>('.fc-meta')!;
    const fcTitle = fcap.querySelector<HTMLElement>('.fc-title')!;
    const fcOpen = fcap.querySelector<HTMLAnchorElement>('.fc-open')!;
    const live = root.querySelector<HTMLElement>('.fc-live')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const NS = 'http://www.w3.org/2000/svg';
    // stage, ruler and legend outlive a mount, so their listeners are dropped on unmount
    const ac = new AbortController();
    const sig = { signal: ac.signal };

    const N = data.length;
    const golden = Math.PI * (3 - Math.sqrt(5));
    const pts = data.map((d, i) => {
      // offset by half a step so no node sits on a pole, where the Y-spin can't move it
      const y = 1 - ((i + 0.5) / N) * 2;
      const r = Math.sqrt(1 - y * y);
      const th = golden * i;
      return { x: Math.cos(th) * r, y, z: Math.sin(th) * r };
    });

    const els = data.map((d) => {
      const a = document.createElement('a');
      a.href = d.url;
      a.style.backgroundImage = `url("${d.src}")`;
      a.setAttribute('aria-label', `${d.title}${d.type ? ', ' + d.type : ''}`);
      a.draggable = false;
      layer.append(a);
      return a;
    });

    // one entry per project (its cover node), in Index order
    const projects: number[] = [];
    data.forEach((d, i) => { if (!data.slice(0, i).some((o) => o.slug === d.slug)) projects.push(i); });
    const P = projects.length;

    const orbitPaths = [0, 1, 2].map(() => {
      const p = document.createElementNS(NS, 'path');
      orbits.append(p);
      return p;
    });

    // immerse: 0 = looking at the globe, 1 = camera inside it. imm chases immT on a critically-damped spring.
    let rotY = 0.6, rotX = -0.25, vy = 0, vx = 0;
    let imm = 0, immV = 0, immT = 0, ease = 0, shownVal = -1;
    let hovered = -1, legendKey = '';
    let dragging = false, moved = 0, lastX = 0, lastY = 0, lastT = 0, prevT = performance.now();
    let W = 0, H = 0, R = 0, CY = 0, D = 2.6, F = 2.6;
    const pointers = new Map<number, { x: number; y: number }>();
    let pinch0 = 0, pinchImm0 = 0;
    const sizes: number[] = data.map(() => 0);
    const proj: { x: number; y: number; s: number; z: number }[] = data.map(() => ({ x: 0, y: 0, s: 1, z: 0 }));

    // focus: the third stage of immersion, one project centred. fw blends each node
    // from its globe spot into the focus slot; ox is its sideways offset (drag / swipe).
    let focus = -1;
    // phones: a focused card holds for a beat, then grows to fill the free space (fill 0 → 1)
    let focusAt = 0, fill = 0, availTop = 72, availBot = 0;
    const fw: number[] = data.map(() => 0);
    const ox: number[] = data.map(() => 0);
    let axis: '' | 'x' | 'rot' = '', startX = 0, startY = 0, flick = 0;
    let wheelLock = 0, wheelX = 0, wheelT = 0;
    const focusNode = () => (focus < 0 ? -1 : projects[focus]);

    // swap in the large source once a node is drawn bigger than the small one can carry
    const upgraded: boolean[] = data.map(() => false);
    function upgrade(i: number) {
      if (upgraded[i]) return;
      upgraded[i] = true;
      const img = new Image();
      img.src = data[i].hi;
      img.decode().then(() => { if (!ac.signal.aborted) els[i].style.backgroundImage = `url("${data[i].hi}")`; }, () => { upgraded[i] = false; });
    }

    const resize = () => {
      W = stage.clientWidth; H = stage.clientHeight;
      // centre the globe in the free band between the header and the headline, equal gap above and below
      const hdr = document.querySelector<HTMLElement>('.site-header');
      const top = hdr ? Math.max(0, hdr.getBoundingClientRect().bottom) : 72;
      const titleTop = caption.offsetTop + title.offsetTop;
      const pad = 20;
      const bandTop = top + pad, bandBot = titleTop - pad;
      CY = (bandTop + bandBot) / 2;
      // nodes reach ~1.2R from centre (perspective), so fit that inside half the band
      R = Math.min(Math.min(W, H) * 0.40, (bandBot - bandTop) / 2 / 1.2);
    };
    const measure = () => { availTop = 72; availBot = fcap.offsetTop - 16; };
    resize();
    window.addEventListener('resize', () => { resize(); if (focus >= 0) measure(); });
    document.fonts?.ready.then(() => stop && resize());

    const setImm = (v: number) => { immT = clamp01(v); };
    const used = () => root.classList.add('used');

    function showFocus(dir: number) {
      const i = projects[focus], d = data[i];
      fcMeta.querySelector('.fc-count')!.textContent = `${String(focus + 1).padStart(2, '0')} / ${String(P).padStart(2, '0')}`;
      fcMeta.querySelector('.fc-type')!.textContent = (d.kind === 'experiments' ? 'Experiment · ' : '') + d.type;
      fcTitle.textContent = d.title;
      fcOpen.href = d.url;
      fcOpen.tabIndex = 0;
      [fcMeta, fcTitle].forEach((el) => { el.classList.remove('in'); void el.offsetWidth; el.classList.add('in'); });
      live.textContent = `${d.title}, ${focus + 1} of ${P}`;
      if (dir) ox[i] = dir * W * 0.3;
      focusAt = performance.now(); fill = 0; measure();
      // warm the neighbours so a swipe lands on a sharp image
      upgrade(i);
      upgrade(projects[(focus + 1) % P]);
      upgrade(projects[(focus - 1 + P) % P]);
    }

    function enterFocus() {
      if (focus >= 0 || !P) return;
      // the cover nearest the centre of the screen (and not about to pass the lens)
      let best = 0, bestScore = Infinity;
      projects.forEach((i, j) => {
        const p = proj[i];
        if (D - p.z < 0.3) return;
        const score = Math.hypot(p.x - W / 2, p.y - CY) / Math.max(1, R) - p.s * 0.2;
        if (score < bestScore) { bestScore = score; best = j; }
      });
      focus = best;
      setImm(1);
      setHover(-1);
      vx = vy = 0;
      root.classList.add('focused');
      showFocus(0);
      used();
    }

    function exitFocus(to = 0.75) {
      if (focus < 0) return;
      focus = -1;
      fill = 0;
      root.classList.remove('focused', 'filled');
      fcOpen.tabIndex = -1;
      live.textContent = '';
      setImm(to);
    }

    function step(dir: number) {
      if (focus < 0 || !P) return;
      focus = (focus + dir + P) % P;
      showFocus(dir);
    }

    function project(x: number, y: number, z: number) {
      const cy = Math.cos(rotY), sy = Math.sin(rotY), cx = Math.cos(rotX), sx = Math.sin(rotX);
      const x1 = x * cy + z * sy, z1 = -x * sy + z * cy;
      const y2 = y * cx - z1 * sx, z2 = y * sx + z1 * cx;
      const s = F / Math.max(0.02, D - z2);
      return { x: W / 2 + x1 * R * s, y: CY + y2 * R * s, s, z: z2 };
    }

    function related(i: number) {
      if (i < 0) return null;
      const h = data[i];
      return data.map((d, j) => (j === i ? 2 : d.slug === h.slug ? 2 : d.disc.some((k) => h.disc.includes(k)) ? 1 : 0));
    }

    function frame(now: number) {
      const dt = Math.min(0.05, Math.max(0.001, (now - prevT) / 1000));
      prevT = now;
      if (reduce) {
        const step = 2.5 * dt;
        imm += Math.max(-step, Math.min(step, immT - imm));
      } else {
        const k = 90;
        immV += (k * (immT - imm) - 2 * Math.sqrt(k) * immV) * dt;
        imm += immV * dt;
      }
      const t = clamp01(imm);
      ease = t * t * (3 - 2 * t);
      D = lerp(2.6, 0.55, ease);
      F = lerp(2.6, 1.5, ease);

      const fn = focusNode();
      if (fn >= 0) {
        // turn the globe so the focused node sits straight ahead, at (0, 0, -1)
        const q = pts[fn];
        const rho = Math.hypot(q.x, q.z);
        const ty = Math.PI - Math.atan2(q.x, q.z), tx = Math.atan2(-q.y, rho);
        const dY = Math.atan2(Math.sin(ty - rotY), Math.cos(ty - rotY));
        const k = reduce ? 1 : 1 - Math.exp(-dt * 5);
        rotY += dY * k; rotX += (tx - rotX) * k;
        vx = vy = 0;
      } else if (!dragging) {
        if (hovered < 0 && !legendKey && !reduce) vy += (0.0016 * (1 - ease * 0.9) - vy) * 0.02;
        else vy *= 0.9;
        vx *= 0.94;
        rotY += vy; rotX += vx;
        // soft clamp, so leaving focus near a pole doesn't snap
        rotX += (Math.max(-1.2, Math.min(1.2, rotX)) - rotX) * 0.15;
      }

      let fmax = 0;
      for (let i = 0; i < N; i++) {
        const target = i === fn ? 1 : 0;
        if (reduce) fw[i] += Math.max(-4 * dt, Math.min(4 * dt, target - fw[i]));
        else fw[i] += (target - fw[i]) * (1 - Math.exp(-dt * 7));
        if (Math.abs(target - fw[i]) < 0.001) fw[i] = target;
        if (!(axis === 'x' && i === fn)) ox[i] = reduce ? 0 : ox[i] * Math.exp(-dt * 9);
        fmax = Math.max(fmax, fw[i]);
      }
      const dim = lerp(1, 0.03, fmax);
      if (fn >= 0 && W < 720) {
        const held = now - focusAt > 1000;
        fill += ((held ? 1 : 0) - fill) * (reduce ? 1 : 1 - Math.exp(-dt * 3.5));
        root.classList.toggle('filled', fill > 0.4);
      } else fill = 0;

      const rel = related(hovered);
      const base = Math.min(96, Math.max(48, R * 0.25)) * lerp(1, 1.5, ease);
      const maxW = Math.min(W, H) * 0.7;
      const dpr = window.devicePixelRatio || 1;
      for (let i = 0; i < N; i++) {
        const p = project(pts[i].x, pts[i].y, pts[i].z);
        proj[i] = p;
        const d = data[i];
        const el = els[i];
        const gap = D - p.z;
        const f = fw[i];
        if (gap < 0.05 && f < 0.001) { el.style.visibility = 'hidden'; continue; }
        el.style.visibility = '';
        const depth = clamp01((p.z + 1) / 2);
        const near = clamp01((gap - 0.08) / 0.4); // fade out as a node approaches the lens
        // a node behind the lens has no globe spot to blend from, so it grows in place
        const behind = gap < 0.05;
        let w = behind ? 0 : Math.min(maxW, base * p.s * Math.sqrt(d.ar) * 0.9);
        let x = behind ? W / 2 : p.x, y = behind ? CY : p.y;
        let op = behind ? 0 : lerp(0.2 + depth * 0.8, 0.65 + depth * 0.35, ease) * near * dim;
        if (f > 0) {
          let sw = Math.min(W * 0.62, H * 0.6 * d.ar);
          let fy = CY;
          if (fill > 0.001 && i === fn) {
            sw = lerp(sw, Math.max(sw, Math.min(W - 32, (availBot - availTop) * d.ar)), fill);
            fy = lerp(CY, (availTop + availBot) / 2, fill);
          }
          w = lerp(w, sw, f);
          x = lerp(x, W / 2 + ox[i], f);
          y = lerp(y, fy, f);
          op = lerp(op, 1, f);
        }
        const h = w / d.ar;
        sizes[i] = w;
        if (w * dpr > 560) upgrade(i);
        el.style.width = w + 'px';
        el.style.height = h + 'px';
        el.style.transform = `translate3d(${x - w / 2}px, ${y - h / 2}px, 0)`;
        el.style.zIndex = String(f > 0.01 ? 1600 + Math.round(f * 100) : Math.round(depth * 1000));
        el.style.opacity = String(op);
        el.classList.toggle('focus', i === fn && f > 0.5);
        const lit = rel ? rel[i] > 0 : legendKey ? d.disc.includes(legendKey) : true;
        el.classList.toggle('dimmed', !lit);
        el.classList.toggle('rel', !!rel && rel[i] === 2 && i !== hovered);
      }

      // orbit rings (they fade before the camera reaches them)
      const ringOp = clamp01(1 - ease * 2.5);
      orbits.style.opacity = String(ringOp);
      if (ringOp > 0) {
        const rings = [
          (t: number) => [Math.cos(t), 0, Math.sin(t)],
          (t: number) => [Math.cos(t), Math.sin(t), 0],
          (t: number) => [0, Math.cos(t), Math.sin(t)],
        ];
        rings.forEach((fn, k) => {
          let dstr = '';
          for (let s = 0; s <= 72; s++) {
            const [x, y, z] = fn((s / 72) * Math.PI * 2);
            const p = project(x * 1.02, y * 1.02, z * 1.02);
            dstr += (s ? 'L' : 'M') + p.x.toFixed(1) + ' ' + p.y.toFixed(1);
          }
          orbitPaths[k].setAttribute('d', dstr);
        });
      }

      // connection lines
      links.textContent = '';
      if (rel && hovered >= 0) {
        const o = proj[hovered];
        for (let j = 0; j < N; j++) {
          if (j === hovered || rel[j] === 0 || D - proj[j].z < 0.05) continue;
          const l = document.createElementNS(NS, 'line');
          l.setAttribute('x1', String(o.x)); l.setAttribute('y1', String(o.y));
          l.setAttribute('x2', String(proj[j].x)); l.setAttribute('y2', String(proj[j].y));
          if (rel[j] === 1) l.setAttribute('class', 'weak');
          links.append(l);
        }
        const p = proj[hovered];
        tip.style.transform = `translate(${Math.min(W - 220, p.x + sizes[hovered] / 2 + 12)}px, ${p.y - 20}px)`;
      }
      // headline steps aside when immersed; hysteresis keeps it from flickering at the edge
      if (imm > 0.35) root.classList.add('zoomed');
      else if (imm < 0.25) root.classList.remove('zoomed');
      root.style.setProperty('--imm', ease.toFixed(3));
      ruler.style.setProperty('--zy', ((1 - clamp01(imm)) * 100).toFixed(2) + '%');
      const val = Math.round(immT * 100);
      if (val !== shownVal) { ruler.setAttribute('aria-valuenow', String(val)); shownVal = val; }
      raf = requestAnimationFrame(frame);
    }

    function setHover(i: number) {
      hovered = i;
      if (i >= 0) {
        tip.querySelector('b')!.textContent = data[i].title;
        tip.querySelector('span')!.textContent = (data[i].kind === 'experiments' ? 'Experiment · ' : '') + data[i].type;
        tip.classList.add('show');
      } else tip.classList.remove('show');
    }

    function open(i: number) {
      navigate(data[i].url);
    }

    els.forEach((el, i) => {
      el.addEventListener('pointerenter', () => focus < 0 && !dragging && !pointers.size && setHover(i));
      el.addEventListener('pointerleave', () => !dragging && setHover(-1));
      el.addEventListener('focus', () => focus < 0 && setHover(i));
      el.addEventListener('blur', () => setHover(-1));
      el.addEventListener('click', (e) => {
        e.preventDefault();
        if (moved > 5) return;
        if (focus >= 0 && i !== focusNode()) return;
        open(i);
      });
    });

    fcOpen.addEventListener('click', (e) => {
      if (focus < 0 || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      open(focusNode());
    }, sig);

    const pinchDist = () => {
      const [a, b] = [...pointers.values()];
      return Math.hypot(a.x - b.x, a.y - b.y) || 1;
    };

    // one pointer rotates; two pointers pinch to immerse
    stage.addEventListener('pointerdown', (e) => {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 1) {
        dragging = true; moved = 0; lastX = e.clientX; lastY = e.clientY; lastT = performance.now();
        startX = e.clientX; startY = e.clientY; axis = '';
        vx = vy = 0;
        stage.classList.add('dragging');
      } else if (pointers.size === 2) {
        dragging = false; moved = 999; axis = '';
        stage.classList.remove('dragging');
        setHover(-1);
        pinch0 = pinchDist(); pinchImm0 = immT;
        pointers.forEach((_, id) => { try { stage.setPointerCapture(id); } catch {} });
      }
    }, sig);
    const onMove = (e: PointerEvent) => {
      const p = pointers.get(e.pointerId);
      if (p) { p.x = e.clientX; p.y = e.clientY; }
      if (pointers.size >= 2) {
        const v = pinchImm0 + Math.log(pinchDist() / pinch0) * 0.9;
        if (focus < 0 && v > 1.15) enterFocus();
        else if (focus >= 0 && v < 0.85) exitFocus(v);
        else if (focus < 0) setImm(v);
        used();
        return;
      }
      if (!dragging) return;
      const dx = e.clientX - lastX, dy = e.clientY - lastY;
      moved += Math.abs(dx) + Math.abs(dy);
      if (focus >= 0 && axis !== 'rot') {
        // focused: sideways drags browse projects, up/down zooms back out
        const tx = e.clientX - startX, ty = e.clientY - startY;
        if (!axis && Math.hypot(tx, ty) > 8) axis = Math.abs(tx) > Math.abs(ty) ? 'x' : 'rot';
        if (axis === 'rot') exitFocus();
        else {
          if (axis === 'x') {
            try { stage.setPointerCapture(e.pointerId); } catch {}
            ox[focusNode()] = tx;
            const now = performance.now();
            flick = dx / Math.max(8, now - lastT); // px per ms
            lastT = now;
          }
          lastX = e.clientX; lastY = e.clientY;
          return;
        }
      }
      if (moved > 5) { setHover(-1); used(); try { stage.setPointerCapture(e.pointerId); } catch {} }
      const k = 0.005 * lerp(1, 0.45, ease); // calmer look-around when inside
      rotY += dx * k; rotX += dy * k;
      const now = performance.now(), dt = Math.max(16, now - lastT);
      vy = (dx * k) * (16 / dt); vx = (dy * k) * (16 / dt);
      lastX = e.clientX; lastY = e.clientY; lastT = now;
    };
    const onUp = (e: PointerEvent) => {
      if (!pointers.has(e.pointerId)) return;
      pointers.delete(e.pointerId);
      if (focus >= 0 && axis === 'x') {
        const tx = ox[focusNode()];
        if (Math.abs(tx) > 60 || Math.abs(flick) > 0.5) step(tx < 0 ? 1 : -1);
        flick = 0;
      }
      axis = '';
      dragging = false; stage.classList.remove('dragging');
    };
    window.addEventListener('pointermove', onMove);
    window.addEventListener('pointerup', onUp);
    window.addEventListener('pointercancel', onUp);

    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      const dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY;
      const dx = e.deltaMode === 1 ? e.deltaX * 16 : e.deltaX;
      const now = performance.now();
      // after a step, swallow the rest of that gesture (trackpad inertia) until it goes quiet
      if (now < wheelLock) { wheelLock = now + 160; return; }
      if (now - wheelT > 200) wheelX = 0;
      wheelT = now;
      used();
      if (focus >= 0) {
        if (Math.abs(dx) > Math.abs(dy)) {
          wheelX += dx;
          if (Math.abs(wheelX) > 40) { step(wheelX > 0 ? 1 : -1); wheelX = 0; wheelLock = now + 160; }
        } else if (dy > 4) { exitFocus(); wheelLock = now + 160; }
        return;
      }
      if (dy < 0 && immT >= 1 && imm > 0.95) { enterFocus(); wheelLock = now + 160; return; }
      setImm(immT - dy * (e.ctrlKey ? 0.01 : 0.0012));
    }, { passive: false, signal: ac.signal });

    stage.addEventListener('keydown', (e) => {
      const k = e.key;
      if (focus >= 0) {
        if (k === 'ArrowLeft') step(-1);
        else if (k === 'ArrowRight') step(1);
        else if (k === 'ArrowUp' || k === 'ArrowDown' || k === 'Escape' || k === '-') exitFocus();
        else if (k === 'Enter') open(focusNode());
        else return;
        e.preventDefault();
        return;
      }
      if ((k === '+' || k === '=') && immT >= 1) enterFocus();
      else if (k === 'ArrowLeft') vy -= 0.02; else if (k === 'ArrowRight') vy += 0.02;
      else if (k === 'ArrowUp') vx -= 0.02; else if (k === 'ArrowDown') vx += 0.02;
      else if (k === '+' || k === '=') setImm(immT + 0.15);
      else if (k === '-') setImm(immT - 0.15);
      else return;
      e.preventDefault();
    }, sig);

    // Immerse ruler: drag the marker (up = in), click a tick, or use the keyboard
    const fromY = (y: number) => {
      const r = track.getBoundingClientRect();
      const v = 1 - (y - r.top) / r.height;
      if (focus >= 0) { if (v < 0.95) exitFocus(v); }
      else if (v >= 0.99) enterFocus();
      else setImm(v);
      used();
    };
    let rulerId = -1;
    ruler.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      rulerId = e.pointerId;
      try { ruler.setPointerCapture(e.pointerId); } catch {}
      ruler.classList.add('active');
      ruler.focus({ preventScroll: true });
      fromY(e.clientY);
    }, sig);
    ruler.addEventListener('pointermove', (e) => { if (e.pointerId === rulerId) fromY(e.clientY); }, sig);
    const rulerUp = (e: PointerEvent) => { if (e.pointerId === rulerId) { rulerId = -1; ruler.classList.remove('active'); } };
    ruler.addEventListener('pointerup', rulerUp, sig);
    ruler.addEventListener('pointercancel', rulerUp, sig);
    ruler.addEventListener('keydown', (e) => {
      const k = e.key;
      const up = k === 'ArrowUp' || k === 'ArrowRight' || k === 'PageUp' || k === 'End';
      if (focus >= 0 && !up && k !== 'Tab') { exitFocus(); e.preventDefault(); return; }
      if (focus < 0 && up && immT >= 1) { enterFocus(); e.preventDefault(); return; }
      if (k === 'ArrowUp' || k === 'ArrowRight' || k === 'PageUp') setImm(immT + (k === 'PageUp' ? 0.25 : 0.05));
      else if (k === 'ArrowDown' || k === 'ArrowLeft' || k === 'PageDown') setImm(immT - (k === 'PageDown' ? 0.25 : 0.05));
      else if (k === 'Home') setImm(0);
      else if (k === 'End') setImm(1);
      else return;
      e.preventDefault();
      used();
    }, sig);

    root.querySelectorAll<HTMLButtonElement>('.legend button').forEach((b) => {
      b.addEventListener('pointerenter', () => { legendKey = b.dataset.k!; b.classList.add('on'); }, sig);
      b.addEventListener('pointerleave', () => { legendKey = ''; b.classList.remove('on'); }, sig);
      b.addEventListener('focus', () => { legendKey = b.dataset.k!; }, sig);
      b.addEventListener('blur', () => { legendKey = ''; }, sig);
    });

    let raf = requestAnimationFrame(frame);
    return () => {
      cancelAnimationFrame(raf);
      ac.abort();
      window.removeEventListener('resize', resize);
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      window.removeEventListener('pointercancel', onUp);
      layer.textContent = '';
      orbits.textContent = '';
      root.classList.remove('zoomed', 'used', 'focused');
      fcOpen.tabIndex = -1;
      live.textContent = '';
      root.style.removeProperty('--imm');
    };
  }

  function sync() {
    const root = document.querySelector<HTMLElement>('.spatial');
    const on = !!root && location.hash === '#spatial';
    document.body.classList.toggle('spatial-on', on);
    if (root) root.hidden = !on;
    if (on && !stop) stop = mount(root!);
    if (!on && stop) { stop(); stop = null; }
    document.dispatchEvent(new CustomEvent('view-change'));
  }

  window.addEventListener('hashchange', sync);
  document.addEventListener('astro:page-load', sync);
  document.addEventListener('astro:before-swap', () => { if (stop) { stop(); stop = null; } });
</script>
