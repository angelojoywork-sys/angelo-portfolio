---
import { getImage } from 'astro:assets';
import Card from './Card.astro';
import { getSite, type Item } from '../lib/content';
interface Props { work: Item[] }
const { work } = Astro.props;
const site = await getSite();
const previews = await Promise.all(
  work.map((w) => (w.cover?.kind === 'image' ? getImage({ src: w.cover.image, width: 480, format: 'webp' }).then((r) => r.src) : ''))
);
const used = Object.entries(site.data.disciplines).filter(([k]) => work.some((w) => w.data.disciplines.includes(k)));
---

<section class="work" aria-label="Selected work">
  <div class="bar">
    <h2 class="label">Selected work <span class="count">({String(work.length).padStart(2, '0')})</span></h2>
    <div class="chips" role="group" aria-label="Filter by discipline">
      <button type="button" class="chip" data-filter="" aria-pressed="true">All</button>
      {used.map(([k, v]) => <button type="button" class="chip" data-filter={k} aria-pressed="false">{v}</button>)}
    </div>
    <div class="layout" role="group" aria-label="Layout">
      <button type="button" data-layout="grid" aria-pressed="true" title="Grid"><svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor"><rect width="6" height="6"/><rect x="8" width="6" height="6"/><rect y="8" width="6" height="6"/><rect x="8" y="8" width="6" height="6"/></svg><span class="visually-hidden">Grid</span></button>
      <button type="button" data-layout="list" aria-pressed="false" title="List"><svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor"><rect width="14" height="2"/><rect y="6" width="14" height="2"/><rect y="12" width="14" height="2"/></svg><span class="visually-hidden">List</span></button>
    </div>
  </div>

  <div class="stepper" aria-label="Project navigation">
    <button type="button" class="step" data-step="-1" aria-label="Previous project"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3L5 8l5 5"/></svg></button>
    <span class="step-count" aria-live="polite"><span class="roll"><span class="strip">{work.map((_, i) => <b>{i + 1}</b>)}</span></span> of {work.length}</span>
    <span class="progress" aria-hidden="true"><i></i></span>
    <button type="button" class="step" data-step="1" aria-label="Next project"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l5 5-5 5"/></svg></button>
  </div>

  <div class="grid">
    {work.map((item, i) => <Card item={item} eager={i < 4} />)}
  </div>

  <ol class="list" hidden>
    {work.map((item, i) => (
      <li>
        <a href={item.url} class="lrow" data-astro-prefetch data-disc={item.data.disciplines.join(' ')} data-preview={previews[i]}>
          <span class="label">{item.number}</span>
          <span class="ltitle">{item.data.title}</span>
          <span class="lmeta">{item.data.type}</span>
          <span class="lmeta hide-sm">{item.data.client}</span>
          <span class="label lyear">{item.data.year}</span>
        </a>
      </li>
    ))}
  </ol>
  <div class="preview" aria-hidden="true"></div>
</section>

<style>
  .work { min-width: 0; }
  .grid[hidden], .list[hidden] { display: none; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px 20px; flex-wrap: wrap; margin-bottom: 20px; }
  .count { color: var(--faint); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-right: auto; }
  .chip { font-size: 12px; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); transition: all var(--dur-1) var(--ease); }
  .chip:hover { color: var(--fg); border-color: var(--faint); }
  .chip[aria-pressed='true'] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .layout { display: inline-flex; gap: 2px; }
  .layout button { padding: 6px; color: var(--faint); border-radius: 4px; }
  .layout button[aria-pressed='true'] { color: var(--fg); background: var(--surface); }

  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px var(--gutter); }
  @media (min-width: 1700px) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }

  .stepper { display: none; }
  /* Phones: projects become a centred deck. Drag a card sideways and it flies off, the next one scales up behind it. */
  @media (max-width: 720px) {
    .stepper { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; font: 400 13px/1 var(--mono); color: var(--muted); }
    .work:has(.grid[hidden]) .stepper { display: none; }
    .step { width: 34px; height: 34px; flex: none; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); color: var(--fg); transition: opacity var(--dur-1), border-color var(--dur-1), transform var(--dur-1) var(--ease); }
    .step:active { transform: scale(.92); }
    .step:disabled { opacity: .3; }
    .step-count { display: inline-flex; gap: .5ch; white-space: nowrap; }
    /* every number is rendered once and the strip slides, so there are never stray digits */
    .roll { display: inline-block; overflow: hidden; height: 1.2em; line-height: 1.2; color: var(--fg); }
    .strip { display: flex; flex-direction: column; transform: translateY(calc(var(--i, 0) * -1.2em)); transition: transform 380ms var(--ease); }
    .strip b { display: block; height: 1.2em; font-weight: 500; }
    .progress { flex: 1; min-width: 24px; height: 2px; border-radius: 2px; background: var(--line); overflow: hidden; }
    .progress i { display: block; height: 100%; background: var(--fg); transform-origin: left; transform: scaleX(var(--p, .25)); }
    .progress i.settle, .strip.settle { transition: transform 380ms var(--ease); }
    .progress i:not(.settle) { transition: none; }

    .grid:not([hidden]) { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; overflow-x: clip; touch-action: pan-y; -webkit-user-select: none; user-select: none; }
    .grid:not([hidden]) :global(.card) {
      grid-area: 1 / 1; align-self: start; width: 100%; will-change: transform, opacity;
      -webkit-touch-callout: none; -webkit-user-drag: none;
    }
    .grid :global(.card.deck-settle) { transition: transform 420ms var(--ease), opacity 320ms var(--ease); }
    .grid :global(.card.deck-off) { pointer-events: none; }
    .grid :global(.card.deck-snap) { transition: none !important; }
    .grid :global(.card img) { -webkit-user-drag: none; pointer-events: none; }
    @media (prefers-reduced-motion: reduce) { .grid :global(.card.deck-settle) { transition: opacity 200ms; } .strip, .strip.settle { transition: none; } }
  }

  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .lrow {
    display: grid; grid-template-columns: 40px minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) 48px;
    gap: 16px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line);
    transition: padding var(--dur-2) var(--ease), opacity var(--dur-2), color var(--dur-2);
  }
  .lrow:hover { padding-left: 10px; }
  .ltitle { font-weight: 550; letter-spacing: -0.01em; }
  .lmeta { color: var(--muted); font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lyear { text-align: right; }
  .lrow.lit { padding-left: 10px; }
  .lrow.lit .ltitle { color: var(--accent); }
  @media (max-width: 720px) { .lrow { grid-template-columns: 32px 1fr auto; } .lmeta { display: none; } }

  .preview {
    position: fixed; left: 0; top: 0; width: 240px; aspect-ratio: 4/3; z-index: 30;
    pointer-events: none; border-radius: 3px; overflow: hidden; box-shadow: var(--shadow);
    opacity: 0; transform: translate(var(--px, 0), var(--py, 0)) scale(0.9) rotate(var(--rot, 0deg));
    transition: opacity var(--dur-1), transform var(--dur-3) var(--ease);
    background: var(--surface) center / cover no-repeat;
  }
  .preview.show { opacity: 1; transform: translate(var(--px, 0), var(--py, 0)) scale(1) rotate(var(--rot, 0deg)); }
  @media (hover: none) { .preview { display: none; } }
</style>

<script>
  function initDeck() {
    const work = document.querySelector<HTMLElement>('.work');
    const grid = work?.querySelector<HTMLElement>('.grid');
    const stepper = work?.querySelector<HTMLElement>('.stepper');
    if (!work || !grid || !stepper) return;
    const phone = matchMedia('(max-width: 720px)');
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
    const N = cards.length;
    const prev = stepper.querySelector<HTMLButtonElement>('[data-step="-1"]')!;
    const next = stepper.querySelector<HTMLButtonElement>('[data-step="1"]')!;
    const strip = stepper.querySelector<HTMLElement>('.strip')!;
    const bar = stepper.querySelector<HTMLElement>('.progress i')!;
    let index = 0, drag = 0, width = 1, settle = true;
    const ac = new AbortController();
    const sig = { signal: ac.signal };
    document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });

    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

    let snap: HTMLElement | null = null;
    function render() {
      const off = !phone.matches || grid.hidden;
      const p = clamp(Math.abs(drag) / (width * 0.5), 0, 1);
      const dir = drag < 0 ? 1 : -1; // the neighbour that is revealed behind the dragged card
      cards.forEach((c, i) => {
        if (off) { c.style.cssText = ''; c.classList.remove('deck-settle', 'deck-off', 'deck-snap'); c.inert = false; c.removeAttribute('aria-hidden'); return; }
        const rel = i - index;
        let x = 0, s = 0.94, o = 0, z = 0;
        if (rel === 0) { x = calm.matches ? 0 : drag; s = 1; o = 1 - p * 0.9; z = 3; }
        else if (rel === dir && drag !== 0) { s = 0.94 + 0.06 * p; o = 0.35 + 0.65 * p; z = 2; }
        else if (rel < 0) { x = -width * 1.1; }   // swiped away to the left, waiting to fly back in
        c.style.transform = `translate3d(${x}px, 0, 0) scale(${s})`;
        c.style.opacity = String(o);
        c.style.zIndex = String(z);
        c.classList.toggle('deck-settle', settle);
        c.classList.toggle('deck-snap', c === snap);
        c.classList.toggle('deck-off', o === 0 && !(rel === 0));
        c.inert = rel !== 0;
        c.setAttribute('aria-hidden', String(rel !== 0));
      });
      strip.style.setProperty('--i', String(index));
      strip.classList.toggle('settle', settle);
      bar.classList.toggle('settle', settle);
      bar.style.setProperty('--p', ((index + 1) / N).toFixed(3));
      prev.disabled = index === 0;
      next.disabled = index === N - 1;
    }

    function measure() { width = grid.clientWidth || 1; }
    function goTo(i: number) {
      const t = clamp(i, 0, N - 1);
      settle = true;
      // fly the current card off in the direction of travel, then make the target active
      if (t !== index) {
        const dir = t > index ? -1 : 1;
        drag = dir * width * 1.1;
        render();
        const old = cards[index];
        requestAnimationFrame(() => {
          snap = t < index ? old : null; // a card that flew off to the right is reset unseen
          index = t; drag = 0; render();
          if (snap) requestAnimationFrame(() => requestAnimationFrame(() => { snap = null; render(); }));
        });
      } else { drag = 0; render(); }
    }

    prev.addEventListener('click', () => goTo(index - 1), sig);
    next.addEventListener('click', () => goTo(index + 1), sig);

    // pointer drag
    let id = -1, sx = 0, sy = 0, lx = 0, lt = 0, vx = 0, dragging = false, moved = 0;
    grid.addEventListener('pointerdown', (e) => {
      if (!phone.matches || grid.hidden || e.pointerType === 'mouse' && e.button !== 0) return;
      id = e.pointerId; sx = lx = e.clientX; sy = e.clientY; lt = e.timeStamp; vx = 0; dragging = false; moved = 0;
    }, sig);
    grid.addEventListener('pointermove', (e) => {
      if (e.pointerId !== id) return;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if (!dragging) {
        if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
        if (Math.abs(dy) > Math.abs(dx)) { id = -1; return; }
        dragging = true; settle = false; measure();
        try { grid.setPointerCapture(e.pointerId); } catch {}
      }
      const dt = Math.max(1, e.timeStamp - lt);
      vx = (e.clientX - lx) / dt; lx = e.clientX; lt = e.timeStamp;
      moved = Math.max(moved, Math.abs(dx));
      // no card beyond the ends: rubber-band
      const blocked = (dx < 0 && index === N - 1) || (dx > 0 && index === 0);
      drag = blocked ? dx * 0.25 : dx;
      render();
    }, sig);
    const end = (e: PointerEvent) => {
      if (e.pointerId !== id) return;
      id = -1;
      if (!dragging) return;
      dragging = false; settle = true;
      const fast = Math.abs(vx) > 0.5;
      const far = Math.abs(drag) > width * 0.28;
      const dir = drag < 0 ? 1 : -1;
      const ok = (fast && Math.sign(vx) === -dir || far) && index + dir >= 0 && index + dir < N;
      if (ok) goTo(index + dir); else { drag = 0; render(); }
    };
    grid.addEventListener('pointerup', end, sig);
    grid.addEventListener('pointercancel', end, sig);
    // a drag must never open the project underneath
    grid.addEventListener('click', (e) => { if (moved > 8) { e.preventDefault(); e.stopPropagation(); moved = 0; } }, { capture: true, signal: ac.signal });
    grid.addEventListener('dragstart', (e) => e.preventDefault(), sig);

    phone.addEventListener('change', () => { measure(); render(); }, sig);
    window.addEventListener('resize', () => { measure(); render(); }, sig);
    document.addEventListener('view-change', render, sig);
    measure(); render();
  }
  document.addEventListener('astro:page-load', initDeck);
</script>
