---
import { getSite } from '../lib/content';
import Puppy from './Puppy.astro';
const site = await getSite();
const headline = site.data.intro.map((s) => s.text).join(' ');
---

<section class="hero" aria-label="About">
  <h1 class="intro">{headline}</h1>

  <dl class="facts">
    <div><dt class="label">Role</dt><dd>{site.data.role}</dd></div>
    {site.data.location && <div><dt class="label">Location</dt><dd>{site.data.location}</dd></div>}
    {site.data.available && <div><dt class="label">Status</dt><dd><span class="avail"></span>{site.data.available}</dd></div>}
  </dl>

  <Puppy />
</section>

<style>
  .hero { display: flex; flex-direction: column; gap: 40px; }
  .intro {
    margin: 0;
    font-size: clamp(30px, 3.1vw, 50px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-family: var(--display);
    font-weight: 500;
    max-width: 18em;
    color: var(--electric);
    text-wrap: pretty;
  }

  .facts { display: flex; flex-wrap: wrap; gap: 16px clamp(24px, 3vw, 48px); margin: 0; }
  .facts dd { text-wrap: balance; }
  @media (min-width: 721px) { .facts dd { white-space: nowrap; } }
  .facts dd { margin: 4px 0 0; font-size: 14px; }
  .avail { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #22c55e; margin-right: 8px; vertical-align: 2px; }
</style>
