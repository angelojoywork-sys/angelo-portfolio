---
import { getSite, type Item } from '../lib/content';
interface Props { work: Item[] }
const { work } = Astro.props;
const site = await getSite();
const workKeys = new Set(work.flatMap((w) => w.data.disciplines));
const sentences = site.data.intro.map((s) => {
  const keys = s.highlight ? ([] as string[]).concat(s.highlight) : [];
  // A sentence about something with no matching work (e.g. AI) links to Experiments instead.
  const toLab = keys.length > 0 && keys.every((k) => !workKeys.has(k));
  return { ...s, keys, toLab };
});
const [availLead, ...availTail] = (site.data.available ?? '').split(' & ');
const availRest = availTail.length ? '& ' + availTail.join(' & ') : '';
---

<section class="hero" aria-label="About">
  <p class="intro">
    {sentences.map((s) =>
      s.toLab ? (
        <a href="/experiments/" class:list={['sent', 'lab', { key: s.key }]} data-hl={s.keys.join(' ')}>{s.text}<span class="arrow" aria-hidden="true">↗</span></a>
      ) : s.keys.length ? (
        <span role="button" tabindex="0" class:list={['sent', 'pick', { key: s.key }]} data-hl={s.keys.join(' ')} aria-pressed="false">{s.text}</span>
      ) : (
        <span class:list={['sent', { key: s.key, lead: !s.key }]}>{s.text}</span>
      )
    ).reduce((acc: any[], el, i) => (i ? [...acc, ' ', el] : [el]), [])}
  </p>

  <dl class="facts">
    <div><dt class="label">Role</dt><dd>{site.data.role}</dd></div>
    {site.data.location && <div><dt class="label">Location</dt><dd>{site.data.location}</dd></div>}
    {site.data.available && <div><dt class="label">Status</dt><dd><span class="avail"></span>{availLead}{availRest && <><br />{availRest}</>}</dd></div>}
  </dl>
</section>

<style>
  .hero { display: flex; flex-direction: column; gap: 40px; }
  .intro {
    margin: 0;
    font-size: clamp(24px, 2.35vw, 38px);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 420;
    max-width: 22em;
    color: var(--faint);
    text-wrap: pretty;
  }
  .sent {
    font: inherit; letter-spacing: inherit; text-align: left; display: inline;
    color: inherit;
    transition: color var(--dur-2) var(--ease), background-size var(--dur-3) var(--ease);
    background: linear-gradient(var(--hover), var(--hover)) left 100% / 0% 2px no-repeat;
    padding-bottom: 2px;
    -webkit-box-decoration-break: clone; box-decoration-break: clone;
    filter: drop-shadow(0 0 0 transparent);
  }
  .sent.on, .pick:hover, a.sent:hover, .sent[aria-pressed='true'] { filter: drop-shadow(0 2px 6px var(--accent-glow)); }
  .sent.lead { transition: color var(--dur-2) var(--ease); }
  .intro:has(.lead:hover) .lead { color: var(--fg); }
  /* Hint: faint dotted blue underline, staggered, telling people these lines respond */
  .intro.hint .pick:not(:hover):not(.on):not([aria-pressed='true']), .intro.hint a.sent:not(:hover):not(.on) {
    text-decoration: underline dotted color-mix(in srgb, var(--hover) 55%, transparent);
    text-decoration-thickness: 1.5px; text-underline-offset: 6px;
    animation: hint-in var(--dur-3) var(--ease) backwards; animation-delay: calc(var(--n, 0) * 140ms);
  }
  @keyframes hint-in { from { text-decoration-color: transparent; } }
  .sent.key { color: var(--fg); }
  .pick, a.sent { cursor: pointer; }
  .pick:hover, a.sent:hover, .sent.on, .sent[aria-pressed='true'] { color: var(--fg); }
  .pick:hover, .sent[aria-pressed='true'] { background-size: 100% 2px; }
  a.sent:hover { background-size: 100% 2px; }
  .arrow { display: inline-block; font-size: 0.6em; vertical-align: 0.5em; margin-left: 0.15em; color: var(--hover); opacity: 0; transform: translate(-4px, 4px); transition: opacity var(--dur-2), transform var(--dur-2) var(--ease); }
  a.sent:hover .arrow { opacity: 1; transform: none; }
  :global(.hl-active) .intro .sent:not(.on):not(:hover):not([aria-pressed='true']) { color: var(--faint); }

  /* Phones: one solid colour; each discipline line gets its underline as it scrolls to mid-screen */
  @media (max-width: 720px) {
    .intro, :global(.hl-active) .intro .sent:not(.on):not(:hover):not([aria-pressed='true']) { color: var(--fg); }
    .pick, a.sent { cursor: auto; -webkit-tap-highlight-color: transparent; }
    .pick:hover, a.sent:hover, .sent.on { filter: none; }
    .sent.pick, .sent.pick:hover, a.sent, a.sent:hover { background-size: calc(var(--u, 0) * 100%) 2px; transition: background-size 120ms linear; }
  }
  @media (max-width: 720px) and (prefers-reduced-motion: reduce) { .sent { transition: none; } }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr)); gap: 16px 24px; margin: 0; max-width: 34em; }
  .facts dd { margin: 4px 0 0; font-size: 14px; }
  .avail { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #22c55e; margin-right: 8px; vertical-align: 2px; }
</style>
