---
import { getSite } from '../lib/content';
const site = await getSite();
const updated = new Date().toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<footer class="site-footer" data-note-on="footer">
  <div class="contact">
    <a href={`mailto:${site.data.email}`} class="u">{site.data.email}</a>
    {site.data.links.map((l) => <a href={l.url} class="u" target={l.url.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a>)}
  </div>
  <div class="meta label">
    <span>Local time <time class="clock" data-tz={site.data.timezone}>--:--</time></span>
    <span>Updated {updated}</span>
    <span>© {new Date().getFullYear()}</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(64px, 10vw, 140px);
    padding: 20px 0 28px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    font-size: 13px;
  }
  .contact { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; }
  @media (max-width: 720px) { .site-footer { padding-bottom: 88px; } }
</style>

<script>
  function tick() {
    document.querySelectorAll<HTMLElement>('.clock').forEach((c) => {
      try {
        c.textContent = new Date().toLocaleTimeString('en-GB', {
          hour: '2-digit', minute: '2-digit', timeZone: c.dataset.tz,
        });
      } catch {
        c.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
      }
    });
  }
  let timer: number | undefined;
  document.addEventListener('astro:page-load', () => {
    tick();
    clearInterval(timer);
    timer = window.setInterval(tick, 15000);
  });
</script>
