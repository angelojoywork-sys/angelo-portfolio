---
// "Reveal my thinking" mode: a design-tool overlay with the layout grid,
// live type specs and your own process notes pinned onto the page.
import { getSite } from '../lib/content';
const site = await getSite();
const initial = site.data.name.trim().charAt(0).toUpperCase();
const first = site.data.name.split(' ')[0];
---

<div class="th-grid" aria-hidden="true">
  {Array.from({ length: 12 }, () => <span></span>)}
  <p class="th-grid-label">12 col · <span class="th-gutter"></span> gutter</p>
</div>
<script type="application/json" id="th-notes" set:html={JSON.stringify({ notes: site.data.notes, initial, first })} />

<style is:global>
  .th-grid {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    padding: 0 var(--gutter);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .th-grid span { background: color-mix(in srgb, var(--accent) 6%, transparent); border-inline: 1px solid color-mix(in srgb, var(--accent) 14%, transparent); transform: scaleY(0); transform-origin: top; transition: transform 0.6s var(--ease); }
  .th-grid-label { position: absolute; right: var(--gutter); top: calc(var(--header-h) + 4px); margin: 0; font: 10px/1 var(--mono); color: var(--accent); background: var(--bg); padding: 3px 5px; }
  html.thinking .th-grid { opacity: 1; }
  html.thinking .th-grid span { transform: scaleY(1); }
  html.thinking .th-grid span:nth-child(n) { transition-delay: calc(var(--i, 0) * 25ms); }

  html.thinking :where([data-spec], [data-note-on], [data-card-note]):not(.site-header) { position: relative; }
  html.thinking [data-spec] { outline: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent); outline-offset: 4px; transition: outline-color .2s; }
  html.thinking [data-spec]:hover { outline: 1px solid var(--accent); }

  .th-gen { font-family: var(--mono); font-size: 10px; line-height: 1; letter-spacing: 0; text-transform: none; font-weight: 400; }
  .th-spec {
    position: absolute; left: -4px; bottom: calc(100% + 6px);
    white-space: nowrap; color: var(--accent-ink); background: var(--accent);
    padding: 3px 5px; border-radius: 2px; z-index: 5; pointer-events: none;
    animation: th-in 0.35s var(--ease) both;
  }
  .th-measure {
    position: absolute; left: 0; right: 0; top: calc(100% + 14px); height: 9px;
    border-inline: 1px solid var(--accent); pointer-events: none; z-index: 4;
    animation: th-in 0.35s var(--ease) both;
  }
  .th-measure::before { content: ''; position: absolute; left: 0; right: 0; top: 4px; border-top: 1px solid var(--accent); }
  .th-measure b { position: absolute; left: 50%; top: -1px; transform: translateX(-50%); background: var(--bg); color: var(--accent); padding: 0 5px; font-weight: 400; white-space: nowrap; }
  .site-header .th-spec { bottom: auto; top: calc(100% + 4px); }

  .th-pin { position: absolute; top: -10px; right: -12px; z-index: 30; animation: th-pop 0.45s var(--ease) both; }
  .th-pin + .th-pin { right: 20px; }
  .th-pin .av {
    display: grid; place-items: center; width: 22px; height: 22px;
    border-radius: 50% 50% 50% 2px; background: var(--accent); color: var(--accent-ink);
    font: 600 11px/1 var(--sans); cursor: help; box-shadow: 0 0 0 2px var(--bg);
    transition: transform 0.25s var(--ease);
  }
  .th-pin:hover .av, .th-pin:focus .av { transform: scale(1.12); }
  .th-pin .av sup { position: absolute; top: -4px; right: -5px; font: 9px/1 var(--mono); background: var(--fg); color: var(--bg); border-radius: 6px; padding: 2px 3px; }
  .th-tip {
    position: absolute; top: 28px; right: 0; width: 240px;
    background: var(--fg); color: var(--bg); border-radius: 8px; padding: 10px 12px;
    font: 13px/1.4 var(--sans); text-align: left; letter-spacing: 0; text-transform: none;
    opacity: 0; transform: translateY(-4px) scale(0.98); transform-origin: top right;
    pointer-events: none; transition: opacity 0.2s, transform 0.25s var(--ease); box-shadow: var(--shadow);
  }
  .th-tip small { display: block; font: 10px/1 var(--mono); opacity: 0.6; margin-bottom: 6px; }
  .th-pin:hover .th-tip, .th-pin:focus .th-tip { opacity: 1; transform: none; }

  @keyframes th-in { from { opacity: 0; transform: translateY(3px); } }
  @keyframes th-pop { from { opacity: 0; transform: scale(0.4); } }
</style>

<script>
  type Note = { on: string; text: string };
  let data: { notes: Note[]; initial: string; first: string } = { notes: [], initial: '', first: '' };

  function clear() {
    document.querySelectorAll('.th-gen').forEach((n) => n.remove());
  }

  function spec(el: HTMLElement) {
    const name = el.dataset.spec!;
    const textEl = (el.dataset.specText ? el.querySelector<HTMLElement>(el.dataset.specText) : null) ?? el;
    if (el.dataset.specKind === 'box') {
      const r = el.getBoundingClientRect();
      return `${name} · ${Math.round(r.width)}×${Math.round(r.height)}`;
    }
    const cs = getComputedStyle(textEl);
    const fam = cs.fontFamily.split(',')[0].replace(/["']/g, '').replace(' Variable', '');
    const size = parseFloat(cs.fontSize);
    const lh = cs.lineHeight === 'normal' ? Math.round(size * 1.2) : Math.round(parseFloat(cs.lineHeight));
    const ls = cs.letterSpacing === 'normal' ? '0' : (parseFloat(cs.letterSpacing) / size).toFixed(2) + 'em';
    return `${name} · ${fam} ${cs.fontWeight} · ${Math.round(size)}/${lh} · ${ls}`;
  }

  function pin(host: HTMLElement, text: string, i: number, n: number) {
    const p = document.createElement('span');
    p.className = 'th-pin th-gen';
    p.tabIndex = 0;
    p.setAttribute('role', 'note');
    p.innerHTML = `<span class="av">${data.initial}${n > 1 ? `<sup>${i + 1}</sup>` : ''}</span><span class="th-tip"><small>${data.first} · note ${i + 1} of ${n}</small></span>`;
    p.querySelector('.th-tip')!.append(text);
    p.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); });
    host.append(p);
  }

  function build() {
    clear();
    if (!document.documentElement.classList.contains('thinking')) return;
    const g = document.querySelector('.th-gutter');
    if (g) g.textContent = Math.round(parseFloat(getComputedStyle(document.querySelector('.th-grid')!).columnGap)) + 'px';
    document.querySelectorAll<HTMLElement>('.th-grid span').forEach((s, i) => s.style.setProperty('--i', String(i)));

    document.querySelectorAll<HTMLElement>('[data-spec]').forEach((el) => {
      if (!el.offsetParent && el.tagName !== 'HEADER') return;
      const s = document.createElement('span');
      s.className = 'th-spec th-gen';
      s.textContent = spec(el);
      el.append(s);
    });

    document.querySelectorAll<HTMLElement>('[data-measure]').forEach((el) => {
      if (!el.offsetParent) return;
      const cs = getComputedStyle(el);
      const w = el.clientWidth;
      const chars = Math.round(w / (parseFloat(cs.fontSize) * 0.5));
      const m = document.createElement('span');
      m.className = 'th-measure th-gen';
      m.innerHTML = `<b>${Math.round(w)}px · ~${chars} chars a line</b>`;
      el.append(m);
    });

    const groups = new Map<string, Note[]>();
    data.notes.forEach((n) => groups.set(n.on, [...(groups.get(n.on) ?? []), n]));
    const total = data.notes.length;
    let idx = 0;
    const order = data.notes.map((n) => n.on).filter((v, i, a) => a.indexOf(v) === i);
    order.forEach((on) => {
      const host = document.querySelector<HTMLElement>(`[data-note-on="${on}"]`);
      (groups.get(on) ?? []).forEach((n) => {
        if (host && (host.offsetParent || host.tagName === 'HEADER')) pin(host, n.text, idx, total);
        idx++;
      });
    });

    const cards = [...document.querySelectorAll<HTMLElement>('[data-card-note]')].filter((c) => c.offsetParent);
    cards.forEach((c, i) => pin(c, c.dataset.cardNote!, i, cards.length));
  }

  let t: number | undefined;
  const rebuild = () => { clearTimeout(t); t = window.setTimeout(build, 120); };

  document.addEventListener('astro:page-load', () => {
    try { data = JSON.parse(document.getElementById('th-notes')!.textContent!); } catch {}
    document.fonts?.ready.then(build);
    build();
  });
  document.addEventListener('thinking-change', build);
  document.addEventListener('view-change', rebuild);
  window.addEventListener('resize', rebuild);
</script>
