---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { Item, Media } from '../lib/content';
import { getSite } from '../lib/content';
import { embedUrl } from '../lib/embed.mjs';

interface Props { item: Item; next: Item; prev: Item; backLabel: string; backHref: string }
const { item, next, prev, backLabel, backHref } = Astro.props;
const site = await getSite();
const { Content } = await render(item.body);
const d = item.data;

const study = d.study;
// With a study, the cards already cover client, type, role, tools and credits, so the header block is dropped
const meta = study
  ? []
  : ([
      ['Client', d.client],
      ['Project type', d.type],
      ['Role', d.role],
      ['Tools', d.tools.join(', ')],
      ['Credits', d.credits],
    ].filter(([, v]) => v) as [string, string][]);
const details = study
  ? [
      ...study.details,
      ...(d.tools.length ? [{ value: d.tools.join(' \u00b7 '), label: 'tools' }] : []),
      ...(d.credits ? [{ value: d.credits, label: 'credits' }] : []),
    ]
  : [];
const chapters = study
  ? ([['Problem', study.problem], ['Solution', study.solution], ['Result', study.result]] as const)
  : [];
// Card headings share one size, scaled so the longest in each column still fits on one line
const leftChars = study ? `Product ${study.product.name}`.length : 0;
const rightChars = study ? Math.max(...chapters.map(([name, c]) => `${name} ${c.subtitle}`.length)) : 0;
// Length of the write-up decides the layout: short ones put Details in a 2 x 2 grid; long ones give the right column more width
const words = study ? study.problem.body.length + study.solution.body.length + study.result.body.length : 0;
const compact = words < 700;
const long = words > 1250;
const split = long ? [1, 2] : compact ? [1, 1] : [2, 3];

const disc = d.disciplines.map((k) => site.data.disciplines[k] ?? k);

const embeds = ([] as string[]).concat(d.embed ?? []);
const cover = item.cover;
const media: Media[] = item.gallery;
---

<article class="detail" data-gap={d.gap}>
  <a href={backHref} class="back label"><span aria-hidden="true">←</span> {backLabel}</a>

  <header class="head">
    <p class="label kicker">{item.number} · {disc.join(' · ')}</p>
    <h1 class="title">{d.title}</h1>
    <p class="lede">{d.summary}</p>

    {meta.length > 0 && <dl class="meta">
      {meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>}
  </header>

  {cover && !d.hideCover && (
    <figure class="frame hero" data-hero>
      {cover.kind === 'image' ? (
        <Image
          src={cover.image}
          alt={cover.caption ?? d.title}
          widths={[800, 1400, 2000, 2600]}
          sizes="(max-width: 1100px) 100vw, 1100px"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <video src={cover.src} autoplay muted loop playsinline />
      )}
    </figure>
  )}

  {study && (
    <section class={`study${compact ? ' compact' : ''}`} aria-label="Case study" style={`--hl:${leftChars};--hr:${rightChars};--lw:${split[0]};--rw:${split[1]};--cols:minmax(0,${split[0]}fr) minmax(0,${split[1]}fr)`}>
      <div class="col">
        <div class="card">
          <h2 class="h">Product <em>{study.product.name}</em></h2>
          <p class="copy">{study.product.description}</p>
        </div>
        {details.length > 0 && (
          <div class="card">
            <h2 class="h">Details</h2>
            <dl class="rows">
              {details.map((r) => <div><dt>{r.value}</dt><dd>{r.label}</dd></div>)}
            </dl>
          </div>
        )}
      </div>
      <div class="card chapters">
        {chapters.map(([name, c]) => (
          <section>
            <h2 class="h">{name} <em>{c.subtitle}</em></h2>
            <p class="copy">{c.body}</p>
          </section>
        ))}
      </div>
      {study.impact.length > 0 && (
        <div class="card impact">
          <h2 class="h">Impact</h2>
          <ul class="stats" data-count={study.impact.length}>
            {study.impact.map((s) => <li><strong>{s.value}</strong><span>{s.label}</span></li>)}
          </ul>
        </div>
      )}
    </section>
  )}

  <div class="story">
    <Content />
    {d.link && <p><a href={d.link.url} class="ext" target="_blank" rel="noopener">{d.link.label} <span aria-hidden="true">↗</span></a></p>}
  </div>

  <div class="gallery">
    {embeds.map((e, i) => (
      <figure class="frame embed"><iframe src={embedUrl(e)} title={`${d.title} video ${i + 1}`} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></figure>
    ))}
    {media.map((m, i) => (
      <figure class="fig">
        <div class="frame">
          {m.kind === 'image' ? (
            <Image
              src={m.image}
              alt={m.caption ?? `${d.title}, image ${i + 1}`}
              widths={[800, 1400, 2000]}
              sizes="(max-width: 1100px) 100vw, 1100px"
              loading="lazy"
              style={`aspect-ratio:${m.image.width}/${m.image.height}`}
            />
          ) : (
            <video src={m.src} autoplay muted loop playsinline controls={false} />
          )}
        </div>
        {m.caption && <figcaption class="label">{m.caption}</figcaption>}
      </figure>
    ))}
  </div>

  <nav class="pager" aria-label="More projects">
    <a href={prev.url} class="pg prev" data-astro-prefetch>
      <span class="label">← Previous</span>
      <span class="pt">{prev.data.title}</span>
    </a>
    <a href="#main" class="label top">Back to top ↑</a>
    <a href={next.url} class="pg next" data-astro-prefetch>
      <span class="label">Next →</span>
      <span class="pt">{next.data.title}</span>
    </a>
  </nav>
</article>

<script>
  // Back to the index: when the entry just before this one is the home page, step back through history
  // (same transition and restored scroll as the browser's own Back); otherwise navigate there normally.
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.detail .back');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey || a.getAttribute('href') !== '/#index') return;
    try {
      const i = history.state?.index;
      const trail = JSON.parse(sessionStorage.getItem('trail') || '{}');
      if (typeof i === 'number' && i > 0 && trail[i - 1] === '/') { e.preventDefault(); history.back(); }
    } catch {}
  });

  // Back to top: smooth-scroll (instant under reduced motion) and move focus to #main without a jump.
  // Capture phase so this runs before Astro's ClientRouter sees the same-page hash link.
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('.detail .top');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    e.stopPropagation();
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || window.scrollY < 2) window.scrollTo(0, 0);
    else {
      // custom tween: native smooth scroll can't be tuned. ~20% slower than the old feel, eased both ends
      const from = window.scrollY;
      const dur = Math.min(2100, 1050 + from * 0.18);
      const t0 = performance.now();
      const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / dur);
        window.scrollTo(0, from * (1 - ease(t)));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
    const main = document.getElementById('main');
    if (main) {
      if (!main.hasAttribute('tabindex')) main.setAttribute('tabindex', '-1');
      main.focus({ preventScroll: true });
    }
  }, true);
</script>

<style>
  .detail { max-width: 1100px; margin: 0 auto; padding-top: clamp(16px, 4vh, 48px); }
  .back { display: inline-flex; gap: 6px; transition: color var(--dur-1), gap var(--dur-2) var(--ease); }
  .back:hover { color: var(--fg); gap: 10px; }
  /* Head on an 8px rhythm: kicker 12 → title 16 → lede 40 → meta */
  .head { padding: clamp(32px, 6vh, 72px) 0 clamp(32px, 5vh, 56px); display: grid; }
  .kicker { color: var(--fg); }
  .title { margin: 12px 0 0; font-size: clamp(40px, 6.4vw, 88px); line-height: 1; letter-spacing: -0.03em; font-family: var(--display); font-weight: 500; text-wrap: balance; }
  .lede { margin: 16px 0 0; color: var(--fg); font-size: 19px; text-wrap: balance; line-height: 1.45; letter-spacing: -0.01em; }

  /* One column: text shares its left and right edges with the media */
  .meta, .story { display: grid; grid-template-columns: minmax(0, 1fr); }
  .meta { margin: 40px 0 0; padding-top: 24px; border-top: 1px solid var(--line); row-gap: 16px; }
  .meta > div { grid-column: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 16px; }
  .meta dt { font-family: var(--display); font-weight: 500; font-size: 14px; }
  .meta dd { margin: 0; color: var(--muted); font-size: 14px; }

  .hero { margin: 0 0 clamp(48px, 8vh, 96px); aspect-ratio: 3 / 2; border-radius: 2px; }
  .hero :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* videos show uncropped at their native ratio (portrait clips are capped to the viewport height) */
  .hero:has(video) { aspect-ratio: auto; background: #000; }
  .hero video { display: block; width: 100%; height: auto; max-height: 90vh; object-fit: contain; }

  /* Case-study cards */
  /* .study is a size container: card padding and heading size scale with its width, so headings stay on one line */
  .study { container-type: inline-size; --pad: clamp(20px, 3.6cqi, 44px); display: grid; grid-template-columns: var(--cols); gap: 12px; margin: 0 0 clamp(32px, 6vh, 64px); align-items: stretch; }
  /* Product sizes to its text; Details stretches so the left column ends level with the right card */
  .col { display: grid; gap: 12px; grid-template-rows: auto 1fr; }
  .card { background: var(--surface); border-radius: 28px; padding: var(--pad); }
  .h { margin: 0 0 20px; font-family: var(--display); font-weight: 500; font-size: clamp(20px, min(calc((100cqi * var(--lw, 2) / (var(--lw, 2) + var(--rw, 3)) - 5px - 2 * var(--pad)) / (var(--hl) * 0.6)), calc((100cqi * var(--rw, 3) / (var(--lw, 2) + var(--rw, 3)) - 7px - 2 * var(--pad)) / (var(--hr) * 0.6))), 30px); line-height: 1.1; letter-spacing: -0.02em; color: var(--fg); }
  .h em { margin-left: 0.35em; font-style: italic; font-weight: 400; color: var(--faint); }
  .copy { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.6; text-wrap: pretty; }
  .col .card:last-child { display: flex; flex-direction: column; }
  .rows { margin: 0; display: grid; grid-auto-rows: 1fr; flex: 1; }
  .rows > div { display: flex; flex-direction: column; justify-content: center; padding: 26px 0; border-top: 1px solid var(--line); }
  .rows > div:first-child { padding-top: 4px; border-top: 0; justify-content: flex-start; }
  .rows > div:last-child { padding-bottom: 0; justify-content: flex-end; }
  .rows dt { font-size: 16px; font-weight: 500; color: var(--fg); line-height: 1.4; }
  .rows dd { margin: 4px 0 0; color: var(--muted); font-size: 16px; }
  @media (min-width: 861px) {
    .compact .rows { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: auto; column-gap: 24px; flex: none; }
    .compact .rows { margin-bottom: -20px; }
    .compact .rows > div, .compact .rows > div:first-child, .compact .rows > div:last-child { padding: 20px 0; border-top: 1px solid var(--line); justify-content: flex-start; }
    .compact .rows > div:nth-child(-n+2) { padding-top: 4px; border-top: 0; }
    .compact .rows > div:nth-child(n+5) { grid-column: 1 / -1; }
  }
  .chapters { display: flex; flex-direction: column; justify-content: space-between; }
  .chapters section { padding: 32px 0; border-top: 1px solid var(--line); }
  .chapters section:first-child { padding-top: 0; border-top: 0; }
  .chapters section:last-child { padding-bottom: 0; }
  .chapters .h { margin-bottom: 14px; }
  .impact { grid-column: 1 / -1; }
  .stats { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); }
  .stats[data-count='1'] { --n: 1; } .stats[data-count='2'] { --n: 2; }
  .stats li { display: grid; gap: 8px; align-content: start; padding: 8px 24px; border-left: 1px solid var(--line); }
  .stats li:first-child { padding-left: 0; border-left: 0; }
  .stats strong { font-family: var(--display); font-weight: 500; font-style: italic; font-size: clamp(30px, 3.3vw, 44px); line-height: 1.05; letter-spacing: -0.03em; color: var(--fg); text-wrap: balance; overflow-wrap: break-word; min-width: 0; }
  .stats span { color: var(--muted); font-size: 15px; line-height: 1.4; }
  @media (max-width: 860px) {
    .study { grid-template-columns: minmax(0, 1fr); }
    /* single column: name on one line, italic subtitle on the next, so nothing is left dangling */
    .h { font-size: 24px; }
    .h em { display: block; margin-left: 0; }
    .rows { grid-auto-rows: auto; flex: none; }
    .rows > div, .rows > div:first-child, .rows > div:last-child { padding: 18px 0; justify-content: flex-start; }
    .rows > div:first-child { padding-top: 4px; }
    .rows > div:last-child { padding-bottom: 0; }
    .chapters { justify-content: flex-start; }
    .stats { grid-template-columns: minmax(0, 1fr); }
    .stats li, .stats li:first-child { padding: 20px 0; border-left: 0; border-top: 1px solid var(--line); }
    .stats li:first-child { padding-top: 0; border-top: 0; }
  }

  .story { color: var(--muted); font-size: 17px; line-height: 1.6; margin-bottom: clamp(24px, 4vw, 48px); align-items: start; }
  .story > :global(*) { grid-column: 1; }
  .story > :global(:is(h2, h3)) {
    margin: 1.5em 0 0.6em; font: 400 12px/1.4 var(--mono); letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg);
  }
  .story :global(p) { margin: 0 0 1em; }
  .story :global(a) { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--faint); transition: text-decoration-color var(--dur-1); }
  .story :global(a:hover) { text-decoration-color: var(--hover); }
  .story :global(ul) { padding-left: 1.2em; margin: 0 0 1em; }
  .story > :global(:is(p:has(img), figure, .embed, .embed-linkedin)) { grid-column: 1 / -1; margin: clamp(8px, 1.2vw, 16px) 0; }
  .story > :global(p:has(img) + p:has(img)) { margin-top: 0; }
  .story :global(.img-grid) { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; align-items: start; margin: clamp(24px, 4vw, 48px) 0; }
  .story :global(.img-grid p) { margin: 0 !important; }
  @media (max-width: 760px) { .story :global(.img-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .detail[data-gap='tight'] .story > :global(:is(p:has(img), figure, .embed)) { margin: 8px 0; }
  .detail[data-gap='tight'] .gallery { gap: 8px; }
  .detail[data-gap='none'] .story > :global(:is(p:has(img), figure, .embed)) { margin: 0; }
  .detail[data-gap='none'] .story { margin-bottom: 0; }
  .detail[data-gap='none'] .gallery { gap: 0; }
  .story :global(img) { width: 100%; height: auto; border-radius: 2px; background: var(--surface); animation: img-in var(--dur-3) var(--ease) both; }
  .story :global(.embed) { aspect-ratio: 16 / 9; background: var(--surface); border-radius: 2px; overflow: hidden; }
  .story :global(.embed iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .story :global(.embed-linkedin) { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 16px; }
  .story :global(.embed-linkedin iframe) { width: 100%; height: 640px; border: 0; border-radius: 2px; background: var(--surface); }
  @keyframes img-in { from { opacity: 0; } }
  .ext { display: inline-flex; gap: 6px; font-family: var(--display); font-weight: 500; text-decoration: none !important; border-bottom: 1px solid var(--fg); padding-bottom: 1px; }

  @media (max-width: 760px) {
    .story { font-size: 16px; }
  }

  .gallery { display: grid; gap: clamp(12px, 1.5vw, 24px); }
  .fig { margin: 0; }
  .fig .frame { border-radius: 2px; }
  .fig :global(img) { width: 100%; height: auto; }
  .fig figcaption { margin-top: 10px; }
  .embed { margin: 0; aspect-ratio: 16 / 9; border-radius: 2px; }
  .embed iframe { width: 100%; height: 100%; border: 0; display: block; }

  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 24px; margin-top: clamp(56px, 10vh, 120px); padding-top: 24px; border-top: 1px solid var(--line); }
  .pg { display: flex; flex-direction: column; gap: 8px; }
  .next { text-align: right; align-items: flex-end; }
  .pt { text-wrap: balance; line-height: 1.1; font-size: clamp(18px, 2vw, 26px); letter-spacing: -0.02em; font-family: var(--display); font-weight: 500; color: var(--muted); transition: color var(--dur-1); }
  .next .pt { font-size: clamp(22px, 2.8vw, 36px); color: var(--fg); letter-spacing: -0.03em; font-weight: 500; }
  .pg:hover .pt { color: var(--accent); }
  .top:hover { color: var(--fg); }
  @media (max-width: 600px) { .top { display: none; } .pager { grid-template-columns: 1fr 1fr; } }
</style>
