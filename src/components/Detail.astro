---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { Item, Media } from '../lib/content';
import { getSite } from '../lib/content';

interface Props { item: Item; next: Item; prev: Item; backLabel: string; backHref: string }
const { item, next, prev, backLabel, backHref } = Astro.props;
const site = await getSite();
const { Content } = await render(item.body);
const d = item.data;

const meta = [
  ['Client', d.client],
  ['Year', String(d.year)],
  ['Project type', d.type],
  ['Role', d.role],
  ['Tools', d.tools.join(', ')],
  ['Credits', d.credits],
].filter(([, v]) => v) as [string, string][];

const disc = d.disciplines.map((k) => site.data.disciplines[k] ?? k);

function embedUrl(url: string) {
  const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/shorts\/)([\w-]{6,})/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
  const vm = url.match(/vimeo\.com\/(\d+)/);
  if (vm) return `https://player.vimeo.com/video/${vm[1]}?dnt=1`;
  return url;
}
const media: Media[] = [item.cover, ...item.gallery].filter(Boolean) as Media[];
---

<article class="detail">
  <a href={backHref} class="back label"><span aria-hidden="true">←</span> {backLabel}</a>

  <header class="head">
    <p class="label kicker">{item.number} · {disc.join(' · ')}</p>
    <h1 class="title">{d.title}</h1>
    <div class="body">
      <p class="lede">{d.summary}</p>
      <Content />
      {d.link && <p><a href={d.link.url} class="ext" target="_blank" rel="noopener">{d.link.label} <span aria-hidden="true">↗</span></a></p>}
    </div>

    <dl class="meta">
      {meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </header>

  <div class="gallery">
    {d.embed && (
      <figure class="frame embed"><iframe src={embedUrl(d.embed)} title={`${d.title} video`} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></figure>
    )}
    {media.map((m, i) => (
      <figure class="fig">
        <div class="frame">
          {m.kind === 'image' ? (
            <Image
              src={m.image}
              alt={m.caption ?? `${d.title}, image ${i + 1}`}
              widths={[800, 1400, 2000]}
              sizes="(max-width: 1100px) 100vw, 1100px"
              loading={i === 0 ? 'eager' : 'lazy'}
              transition:name={i === 0 ? `media-${item.kind}-${item.slug}` : undefined}
              style={`aspect-ratio:${m.image.width}/${m.image.height}`}
            />
          ) : (
            <video src={m.src} autoplay muted loop playsinline controls={false} />
          )}
        </div>
        {m.caption && <figcaption class="label">{m.caption}</figcaption>}
      </figure>
    ))}
  </div>

  <nav class="pager" aria-label="More projects">
    <a href={prev.url} class="pg prev">
      <span class="label">← Previous</span>
      <span class="pt">{prev.data.title}</span>
    </a>
    <a href="#main" class="label top">Back to top ↑</a>
    <a href={next.url} class="pg next">
      <span class="label">Next →</span>
      <span class="pt">{next.data.title}</span>
    </a>
  </nav>
</article>

<style>
  .detail { max-width: 1100px; margin: 0 auto; padding-top: clamp(16px, 4vh, 48px); }
  .back { display: inline-flex; gap: 6px; transition: color .2s, gap .3s var(--ease); }
  .back:hover { color: var(--fg); gap: 10px; }
  .head { padding: clamp(32px, 6vh, 72px) 0 clamp(32px, 5vh, 56px); display: grid; gap: 28px; }
  .kicker { color: var(--faint); }
  .title { margin: -12px 0 0; font-size: clamp(40px, 6.4vw, 88px); line-height: 0.98; letter-spacing: -0.05em; font-weight: 450; text-wrap: balance; }
  .body { max-width: 62ch; color: var(--muted); font-size: 16px; line-height: 1.6; }
  .body .lede { color: var(--fg); font-size: 19px; line-height: 1.45; letter-spacing: -0.01em; margin-top: 0; }
  .body :global(h2) { color: var(--fg); font-size: 15px; font-weight: 550; margin: 2em 0 0.4em; letter-spacing: -0.01em; }
  .body :global(p) { margin: 0 0 1em; }
  .body :global(a) { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--faint); }
  .body :global(ul) { padding-left: 1.2em; }
  .ext { display: inline-flex; gap: 6px; font-weight: 550; text-decoration: none !important; border-bottom: 1px solid var(--fg); padding-bottom: 1px; }
  .meta { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 20px 32px; margin: 12px 0 0; padding-top: 24px; border-top: 1px solid var(--line); }
  .meta dt { font-weight: 550; font-size: 14px; }
  .meta dd { margin: 4px 0 0; color: var(--muted); font-size: 14px; }

  .gallery { display: grid; gap: clamp(16px, 2vw, 28px); }
  .fig { margin: 0; }
  .fig .frame { border-radius: 2px; }
  .fig :global(img) { width: 100%; height: auto; }
  .fig figcaption { margin-top: 10px; }
  .embed { margin: 0; aspect-ratio: 16 / 9; border-radius: 2px; }
  .embed iframe { width: 100%; height: 100%; border: 0; display: block; }

  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 24px; margin-top: clamp(56px, 10vh, 120px); padding-top: 24px; border-top: 1px solid var(--line); }
  .pg { display: flex; flex-direction: column; gap: 6px; }
  .next { text-align: right; align-items: flex-end; }
  .pt { font-size: clamp(18px, 2vw, 26px); letter-spacing: -0.02em; font-weight: 450; transition: color .2s; }
  .pg:hover .pt { color: var(--accent); }
  .top:hover { color: var(--fg); }
  @media (max-width: 600px) { .top { display: none; } .pager { grid-template-columns: 1fr 1fr; } }
</style>
