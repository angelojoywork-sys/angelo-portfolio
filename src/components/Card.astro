---
import { Image } from 'astro:assets';
import type { Item, Media } from '../lib/content';
interface Props { item: Item; eager?: boolean; showNote?: boolean }
const { item, eager = false, showNote = true } = Astro.props;
const peek: Media | undefined = item.gallery.find((m) => m.kind === 'image');
const sizes = '(max-width: 720px) 100vw, (max-width: 1200px) 30vw, 22vw';
---

<a
  href={item.url}
  class="card"
  data-astro-prefetch
  data-disc={item.data.disciplines.join(' ')}
  data-card-note={showNote ? item.data.note : undefined}
>
  <div class="frame media" transition:name={`media-${item.kind}-${item.slug}`}>
    {item.cover?.kind === 'image' && (
      <Image src={item.cover.image} alt={item.data.title} widths={[480, 800, 1200]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} class="cover" />
    )}
    {item.cover?.kind === 'video' && <video src={item.cover.src} muted loop playsinline autoplay class="cover" />}
    {peek?.kind === 'image' && (
      <Image src={peek.image} alt="" widths={[480, 800]} sizes={sizes} loading="lazy" class="peek" aria-hidden="true" />
    )}
  </div>
  <div class="row">
    <h3 class="title">{item.data.title}</h3>
    <span class="label num">{item.number}</span>
  </div>
  <p class="sum">{item.data.summary}</p>
  <p class="label tags">{item.data.type ?? item.data.disciplines.join(' · ')} · {item.data.year}</p>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 10px; outline: none; }
  .media { aspect-ratio: 4 / 3; border-radius: 3px; transition: box-shadow var(--dur-2) var(--ease); }
  .media :global(img), .media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-3) var(--ease), clip-path var(--dur-3) var(--ease); }
  .media .peek { clip-path: inset(0 0 0 100%); }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 4px; }
  .title { margin: 0; font-size: 15px; font-weight: 550; letter-spacing: -0.01em; }
  .title::after { content: ' →'; display: inline-block; opacity: 0; transform: translateX(-6px); transition: opacity var(--dur-1), transform var(--dur-2) var(--ease); color: var(--accent); }
  .sum { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.4; max-width: 40ch; }
  .tags { margin-top: 2px; }

  /* Hover, keyboard focus and the hero's "lit" state all read the same */
  .card:is(:hover, :focus-visible, .lit) .media { box-shadow: 0 0 0 3px var(--bg), 0 0 0 4.5px var(--hover), 0 0 24px 2px var(--accent-glow); }
  .card:is(:hover, :focus-visible, .lit) .media .cover { transform: scale(1.04); }
  .card:is(:hover, :focus-visible, .lit) .title::after { opacity: 1; transform: none; }
  /* the second image peeks in only after a deliberate pause */
  .card:is(:hover, :focus-visible) .media .peek { clip-path: inset(0 0 0 0%); transition-delay: var(--dur-2); }
  /* Phones: no ring or hover effects; the deck in WorkIndex moves the cards */
  @media (max-width: 720px), (hover: none) {
    .card:is(:hover, :focus-visible, .lit) .media { box-shadow: none; }
    .card:is(:hover, :focus-visible, .lit) .media .cover { transform: none; }
    .card:is(:hover, :focus-visible) .media .peek { clip-path: inset(0 0 0 100%); }
    .card:is(:hover, :focus-visible, .lit) .title::after { opacity: 0; }
  }
  @media (max-width: 720px) {
    .card:active .media { transform: scale(.985); transition: transform var(--dur-1) var(--ease); }
  }
  /* drop the ring before the page morph captures the frame */
  .card.leaving .media { box-shadow: none; transition: none; }
</style>

<script>
  document.addEventListener('click', (e) => {
    const c = (e.target as HTMLElement).closest<HTMLElement>('.card');
    if (c && !(e.metaKey || e.ctrlKey || e.shiftKey)) c.classList.add('leaving');
  });
  document.addEventListener('astro:after-swap', () => document.querySelectorAll('.card.leaving').forEach((c) => c.classList.remove('leaving')));
  window.addEventListener('pageshow', () => document.querySelectorAll('.card.leaving').forEach((c) => c.classList.remove('leaving')));
</script>
