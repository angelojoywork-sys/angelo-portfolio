---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Item } from '../lib/content';
interface Props { item: Item; eager?: boolean; showNote?: boolean }
const { item, eager = false, showNote = true } = Astro.props;
// Up to four stills from inside the project make the hover preview reel: the gallery
// first, then images the write-up places inline (most projects keep them all there).
const stills = import.meta.glob<ImageMetadata>('/content/**/*.{jpg,jpeg,png,webp,avif,gif,JPG,JPEG,PNG}', { eager: true, import: 'default' });
const folder = '/' + (item.body.filePath ?? '').replace(/\\/g, '/').replace(/index\.md$/, '');
const inline = [...(item.body.body ?? '').matchAll(/\]\((?:\.\/)?([^)\s/]+\.(?:jpe?g|png|webp|avif|gif))/gi)].map((m) => m[1]);
const files = [...new Set([...item.gallery.filter((m) => m.kind === 'image').map((m) => m.file), ...inline])];
const previews = files
  .filter((f) => f !== item.cover?.file && stills[folder + f])
  .slice(0, 4)
  .map((f) => stills[folder + f]);
const pills = (item.data.type ?? '').split(/\s*[·&,]\s*/).filter(Boolean);
const sizes = '(max-width: 720px) 100vw, (max-width: 1200px) 30vw, 22vw';
---

<a
  href={item.url}
  class="card"
  data-astro-prefetch
  data-disc={item.data.disciplines.join(' ')}
  data-card-note={showNote ? item.data.note : undefined}
>
  <div class="frame media">
    {item.cover?.kind === 'image' && (
      <Image src={item.cover.image} alt={item.data.title} widths={[480, 800, 1200]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} class="cover" />
    )}
    {item.cover?.kind === 'video' && <video src={item.cover.src} muted loop playsinline autoplay class="cover" />}
    {previews.map((m, i) => (
      <Image src={m} alt="" widths={[480, 800]} sizes={sizes} loading="lazy" class="pv" data-i={i} aria-hidden="true" />
    ))}
    {pills.length > 0 && (
      <ul class="pills" aria-hidden="true">{pills.map((p, i) => <li style={`--i:${i}`}>{p}</li>)}</ul>
    )}
  </div>
  <div class="row">
    <h3 class="title">{item.data.title}</h3>
    <span class="label num">{item.number}</span>
  </div>
  <p class="sum">{item.data.summary}</p>
</a>

<script>
  // Cards lean toward the pointer (up to 6°) while lifted, and play a reel of
  // the project's stills: auto-advancing, or scrubbed by moving across the image.
  const STEP = 1700, WAIT = 350, IDLE = 1200;
  const resets = new Set<() => void>();

  function bindCards() {
    if (!matchMedia('(hover: hover) and (min-width: 721px)').matches) return;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      const media = card.querySelector<HTMLElement>('.media');
      if (!media || card.dataset.tilt) return;
      card.dataset.tilt = '1';
      const pvs = [...media.querySelectorAll<HTMLElement>('.pv')];
      const n = pvs.length;
      let at = -1, timer = 0, lastX = 0;

      const show = (k: number) => {
        at = k;
        card.classList.add('previewing');
        pvs.forEach((p, j) => p.classList.toggle('on', j === k));
      };
      const play = () => {
        show((at + 1) % n);
        if (!still && n > 1) timer = window.setTimeout(play, STEP);
      };
      const reset = () => {
        clearTimeout(timer);
        at = -1;
        card.classList.remove('previewing');
        pvs.forEach((p) => p.classList.remove('on'));
      };
      if (n) resets.add(reset);

      media.addEventListener('pointerenter', (e) => {
        lastX = e.clientX;
        if (n) timer = window.setTimeout(play, WAIT);
      });
      media.addEventListener('pointermove', (e) => {
        const r = media.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height - 0.5;
        if (!still) {
          card.classList.add('tilting');
          media.style.setProperty('--rx', ((x - 0.5) * 12).toFixed(2) + 'deg');
          media.style.setProperty('--ry', (-y * 12).toFixed(2) + 'deg');
        }
        // horizontal movement scrubs the reel; auto-advance resumes after a pause
        const dx = Math.abs(e.clientX - lastX);
        lastX = e.clientX;
        if (still || n < 2 || at < 0 || dx < 2) return;
        clearTimeout(timer);
        const k = Math.min(n - 1, Math.max(0, Math.floor(x * n)));
        if (k !== at) show(k);
        timer = window.setTimeout(play, IDLE);
      });
      media.addEventListener('pointerleave', () => {
        reset();
        card.classList.remove('tilting');
        media.style.removeProperty('--rx');
        media.style.removeProperty('--ry');
      });
    });
  }
  document.addEventListener('astro:page-load', bindCards);
  document.addEventListener('astro:before-swap', () => { resets.forEach((r) => r()); resets.clear(); });
</script>

<style>
  .card { display: flex; flex-direction: column; gap: 10px; outline: none; }
  .media {
    aspect-ratio: 4 / 3; border-radius: 3px;
    --rx: 0deg; --ry: 0deg; --lift: 0px;
    transform: perspective(900px) rotateX(var(--ry)) rotateY(var(--rx)) translateY(var(--lift));
    box-shadow: 0 0 0 transparent;
    transition: transform var(--dur-3) var(--ease), box-shadow var(--dur-3) var(--ease);
  }
  /* while the pointer steers the tilt, follow it closely instead of lagging behind */
  .card.tilting .media { transition: transform .12s linear, box-shadow var(--dur-3) var(--ease); }
  .media :global(img), .media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-3) var(--ease); }
  /* Preview reel: stills cross-fade slowly over the cover */
  .media .pv { opacity: 0; transition: opacity 1s var(--ease), transform var(--dur-3) var(--ease); }
  .media .pv.on { opacity: 1; }
  /* Rounded tag pills slide up inside the image on hover */
  .pills { position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; list-style: none; pointer-events: none; }
  .pills li {
    padding: 6px 12px; border-radius: 999px; font-size: 12px; line-height: 1; color: #111; background: rgb(255 255 255 / .92);
    backdrop-filter: blur(6px); box-shadow: 0 2px 8px rgb(0 0 0 / .12);
    opacity: 0; transform: translateY(18px);
    transition: opacity var(--dur-2) var(--ease), transform var(--dur-3) var(--ease);
    transition-delay: calc(var(--i) * 60ms);
  }
  .card:is(:hover, :focus-visible, .lit) .pills li { opacity: 1; transform: none; }
  /* keyboard focus just shows the first still */
  .card:focus-visible:not(.previewing) .pv[data-i="0"] { opacity: 1; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 4px; }
  .title { margin: 0; font-family: var(--display); font-size: 18px; font-weight: 500; letter-spacing: -0.01em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; flex: 1 1 auto; }
  .title::after { content: ' →'; display: inline-block; opacity: 0; transform: translateX(-6px); transition: opacity var(--dur-1), transform var(--dur-2) var(--ease); color: var(--accent); }
  .sum { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.4; max-width: 40ch; text-wrap: balance; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; min-height: 2.8em; }
  @media (max-width: 1400px) { .title { font-size: 16px; } }
  @media (max-width: 1180px) { .title { font-size: 13px; } .sum { font-size: 13px; -webkit-line-clamp: 3; line-clamp: 3; min-height: 4.2em; } }
  @media (max-width: 720px) { .title { font-size: 18px; } .sum { font-size: 14px; -webkit-line-clamp: 2; line-clamp: 2; min-height: 2.8em; } }
  @media (min-width: 1700px) { .title { font-size: 16px; } }

  /* Hover, keyboard focus and the hero's "lit" state all read the same */
  .card:is(:hover, :focus-visible, .lit) .media { --lift: -8px; box-shadow: 0 2px 4px rgb(0 0 0 / .06), 0 18px 36px -12px rgb(0 0 0 / .28); }
  .card:is(:hover, :focus-visible, .lit) .media :is(.cover, .pv) { transform: scale(1.04); }
  .card:is(:hover, :focus-visible, .lit) .title::after { opacity: 1; transform: none; }
  /* Phones: no ring or hover effects; the deck in WorkIndex moves the cards */
  @media (max-width: 720px), (hover: none) {
    .card:is(:hover, :focus-visible, .lit) .media { --lift: 0px; --rx: 0deg; --ry: 0deg; box-shadow: none; }
    .card:is(:hover, :focus-visible, .lit) .media .cover { transform: none; }
    .media :is(.pv, .pills) { display: none; }
    .card:is(:hover, :focus-visible, .lit) .title::after { opacity: 0; }
  }
  @media (max-width: 720px) {
    .card:active .media { transform: scale(.985); transition: transform var(--dur-1) var(--ease); }
  }
  @media (prefers-reduced-motion: reduce) {
    .media { --rx: 0deg !important; --ry: 0deg !important; }
    .pills li { transition: opacity var(--dur-1); transform: none; }
  }
</style>

