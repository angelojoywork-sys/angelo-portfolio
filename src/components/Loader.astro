---
interface Props { name: string }
const { name } = Astro.props;
---

<div class="loader" aria-hidden="true">
  <span class="loader__a">{name.charAt(0)}</span>
</div>

<style is:global>
  .loader { display: none; }
  html.has-loader { overflow: hidden; }
  html.has-loader .loader {
    position: fixed; inset: 0; z-index: 200; display: block; background: var(--brand); overflow: hidden;
  }
  /* same face, weight and spacing as the header brand, so the letter can land on it exactly */
  .loader__a {
    position: absolute; top: 0; left: 0; transform-origin: 0 0; white-space: nowrap;
    font-family: var(--display); font-weight: 500; letter-spacing: -0.01em; line-height: 1.5;
    font-size: clamp(180px, 40vw, 380px); color: #fff; opacity: 0;
    will-change: transform, filter, opacity;
  }
</style>

<script>
  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>('.loader');
  const letter = document.querySelector<HTMLElement>('.loader__a');

  // Timeline (ms): the letter eases in, holds, then travels to the header brand while the curtain lifts.
  const ENTER = 420, HOLD = 850, FLY = 850, REST = 1450;
  const OUT = 'cubic-bezier(0.2, 0.7, 0.1, 1)';
  const IN_OUT = 'cubic-bezier(0.65, 0, 0.35, 1)';

  const done = () => root.classList.remove('has-loader');

  async function play() {
    if (!loader || !letter) return done();
    try { await document.fonts.ready; } catch {}
    const target = document.querySelector<HTMLElement>('.brand-init');
    if (!target) return done();

    const a = letter.getBoundingClientRect();
    const t = target.getBoundingClientRect();
    const cx = (innerWidth - a.width) / 2, cy = (innerHeight - a.height) / 2;
    const scale = t.height / a.height;
    const ink = getComputedStyle(document.body).color;
    const at = (x: number, y: number, s: number) => `translate(${x}px, ${y}px) scale(${s})`;
    const total = HOLD + FLY;

    const move = letter.animate([
      { transform: at(cx, cy, 0.92), opacity: 0, filter: 'blur(14px)', color: '#fff', easing: OUT },
      { offset: ENTER / total, transform: at(cx, cy, 1), opacity: 1, filter: 'blur(0px)', color: '#fff' },
      { offset: HOLD / total, transform: at(cx, cy, 1), opacity: 1, filter: 'blur(0px)', color: '#fff', easing: IN_OUT },
      { transform: at(t.left, t.top, scale), opacity: 1, filter: 'blur(0px)', color: ink },
    ], { duration: total, fill: 'forwards' });

    loader.animate(
      [{ backgroundColor: getComputedStyle(loader).backgroundColor }, { backgroundColor: 'rgba(0, 0, 0, 0)' }],
      { delay: HOLD, duration: FLY * 0.8, easing: IN_OUT, fill: 'forwards' },
    );

    // the rest of the name rises in just before the letter lands
    setTimeout(() => root.classList.add('loader-rest'), REST);
    try { await move.finished; } catch {}
    done();
  }

  if (root.classList.contains('has-loader')) {
    play();
    setTimeout(done, 4000);
  }
</script>
