---
interface Props { name: string }
const { name } = Astro.props;
---

<div class="loader" aria-hidden="true">
  <div class="mark">
    <svg class="smile" viewBox="0 0 24 24" width="56" height="56">
      <circle cx="12" cy="12" r="11" />
      <ellipse cx="8.5" cy="9.5" rx="1.5" ry="2" />
      <ellipse cx="15.5" cy="9.5" rx="1.5" ry="2" />
      <path d="M7 14.5c1.2 2.4 3 3.3 5 3.3s3.8-.9 5-3.3" stroke-linecap="round" />
    </svg>
    <svg class="word" viewBox="0 0 330 64" height="48">
      <text x="0" y="48">{name}</text>
    </svg>
  </div>
</div>

<style is:global>
  .loader { display: none; }
  html.has-loader { overflow: hidden; }
  html.has-loader .loader {
    position: fixed; inset: 0; z-index: 200; display: grid; place-items: center;
    background: var(--accent); color: #fff;
    animation: loader-sweep 800ms var(--ease) 1.6s forwards;
  }
  .loader .mark { display: flex; align-items: center; gap: 16px; }
  .loader svg { overflow: visible; }
  .loader .smile * { fill: none; stroke: #fff; stroke-width: 0.7; stroke-dasharray: 80; stroke-dashoffset: 80; animation: loader-draw 1.1s var(--ease) 0.15s forwards; }
  .loader .smile path { stroke-width: 1.2; }
  .loader .word text {
    font: 500 52px/1 var(--sans, inherit); letter-spacing: -0.04em;
    fill: transparent; stroke: #fff; stroke-width: 1; stroke-dasharray: 2000; stroke-dashoffset: 2000;
    animation: loader-draw 1.3s var(--ease) 0.2s forwards, loader-fill 0.3s ease-out 1.3s forwards;
  }
  html.has-loader .brand-name { animation-delay: 1.9s; }
  @keyframes loader-draw { to { stroke-dashoffset: 0; } }
  @keyframes loader-fill { to { fill: #fff; } }
  @keyframes loader-sweep { to { transform: translateY(-100%); } }
</style>

<script>
  const done = () => {
    try { sessionStorage.setItem('loaded', '1'); } catch {}
    document.documentElement.classList.remove('has-loader');
  };
  const el = document.querySelector('.loader');
  if (el && document.documentElement.classList.contains('has-loader')) {
    el.addEventListener('animationend', (e) => { if ((e as AnimationEvent).animationName === 'loader-sweep') done(); });
    setTimeout(done, 4000);
  }
</script>
