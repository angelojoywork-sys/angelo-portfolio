---
// Lycan, a tiny beagle who sleeps in the grass until you tap. Then he wakes, runs over, woofs and plays.
// Sprite frames (public/beagle.png, made by scripts/make-beagle.py):
// 0 stand, 1 sit, 2 crouch, 3 sleep, 4 sleep (breath in), 5-6 roll on back, 7 on side, 8-15 run cycle.
// A natural meadow: a pair, a stray, a lone tall one in the middle, a stray, then another pair.
const flowers = [
  { x: 8, c: 0, s: 1, d: 0, t: 9 }, { x: 12.5, c: 1, s: 0.8, d: 2.4, t: 7.5 },
  { x: 31, c: 2, s: 0.75, d: 5, t: 10 },
  { x: 50, c: 0, s: 1.15, d: 1.2, t: 8 },
  { x: 70, c: 1, s: 0.8, d: 3.8, t: 9.5 },
  { x: 88, c: 2, s: 1, d: 0.6, t: 7 }, { x: 92.5, c: 0, s: 0.85, d: 4.4, t: 10.5 },
];
---

<button type="button" class="pup" aria-label="Play with Lycan">
  <span class="label hint" aria-hidden="true">Play with Lycan</span>
  <span class="flowers" aria-hidden="true">
    {flowers.map((f) => <span class="flower" style={`left:${f.x}%;--row:${f.c};--s:${f.s};--delay:-${f.d}s;--dur:${f.t}s`}></span>)}
  </span>
  <span class="grass" aria-hidden="true"></span>
  <span class="dog asleep" aria-hidden="true">
    <span class="zzz"><i>z</i><i>z</i><i>z</i></span>
    <span class="bubble">Woof!</span>
    <span class="face">
      <span class="bob">
        <span class="sprite"></span>
      </span>
    </span>
  </span>
</button>

<style>
  .pup {
    position: relative;
    display: block;
    width: 100%;
    height: 140px;
    text-align: left;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  /* ground: pixel grass tufts (public/grass.png, made by scripts/make-beagle.py), tiled across */
  .grass {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
    height: 12px;
    pointer-events: none;
    background: url('/grass.png') repeat-x left bottom / 78px 12px;
    image-rendering: pixelated;
  }

  .hint { position: absolute; top: 0; right: 0; transition: opacity var(--dur-3) var(--ease); pointer-events: none; }
  .pup.played .hint { opacity: 0; }

  .dog { z-index: 1; position: absolute; left: 0; bottom: 10px; width: 108px; height: 72px; transform: translateX(8px); will-change: transform; pointer-events: none; }
  .face, .bob { display: block; width: 100%; height: 100%; }
  .face { transition: transform var(--dur-1) var(--ease); }
  .dog.left .face { transform: scaleX(-1); }
  svg { display: block; overflow: visible; }

  /* pixel sprite sheet: 16 frames of 36x24 px at 3x; the script sets --f to pick one */
  .sprite { display: block; width: 108px; height: 72px; background: url('/beagle.png') calc(var(--f, 3) * -108px) 0 / 1728px 72px no-repeat; image-rendering: pixelated; }
  .bob { transform-origin: 50% 100%; }
  /* awake and standing: a slow two-step breath */
  .dog.stand .bob { animation: breathe 1.6s steps(1, end) infinite; }
  @keyframes breathe { 0% { transform: translateY(0); } 50% { transform: translateY(3px); } }

  /* arrival hop: squash, stretch, land, settle */
  .dog.hop .bob { animation: hop .6s var(--ease); }
  @keyframes hop {
    0% { transform: scale(1.08, .88); }
    22% { transform: translateY(-16px) scale(.92, 1.12); }
    55% { transform: translateY(0) scale(1.1, .86); }
    75% { transform: scale(.97, 1.04); }
    100% { transform: none; }
  }
  /* anticipation: a quick crouch before the sprint */
  .dog.perk .bob { animation: perk .26s var(--ease) both; }
  @keyframes perk { 0% { transform: none; } 60% { transform: scale(1.06, .9); } 100% { transform: scale(1.02, .96); } }

  /* z z z drift up from the head in time with the 2.8s breath */
  .zzz { position: absolute; left: 76px; bottom: 54px; width: 30px; height: 40px; pointer-events: none; opacity: 0; }
  .dog.asleep .zzz { opacity: 1; }
  .dog.left .zzz { left: auto; right: 76px; }
  .zzz i {
    position: absolute; left: 0; bottom: 0;
    font: 700 13px/1 var(--mono, monospace); font-style: normal; color: var(--electric);
    opacity: 0; transform-origin: 0 100%;
    animation: zzz 4.2s var(--ease) infinite;
  }
  .zzz i:nth-child(2) { animation-delay: 1.4s; }
  .zzz i:nth-child(3) { animation-delay: 2.8s; }
  @keyframes zzz {
    0% { opacity: 0; transform: translate(0, 0) scale(.6); }
    15% { opacity: 1; }
    100% { opacity: 0; transform: translate(14px, -34px) scale(1.5); }
  }

  /* pixel flowers: bud > open > wide > close, staggered so the meadow never blooms in unison */
  .flowers { position: absolute; left: 0; right: 0; bottom: 10px; height: 36px; pointer-events: none; }
  .flower {
    position: absolute; bottom: 0; width: 27px; height: 36px; margin-left: -13px; transform-origin: 50% 100%; scale: var(--s, 1);
    background: url('/flowers.png') 0 calc(var(--row) * -36px) / 108px 108px no-repeat; image-rendering: pixelated;
    animation: bloom var(--dur) steps(1, end) var(--delay) infinite;
  }
  @keyframes bloom {
    0% { background-position: 0 calc(var(--row) * -36px); }
    30% { background-position: -27px calc(var(--row) * -36px); }
    45% { background-position: -54px calc(var(--row) * -36px); }
    60% { background-position: -81px calc(var(--row) * -36px); }
    80% { background-position: -54px calc(var(--row) * -36px); }
    92% { background-position: -27px calc(var(--row) * -36px); }
  }
  /* secondary action: flowers sway as the dog brushes past (class set by the script) */
  .flower.sway { animation: bloom var(--dur) steps(1, end) var(--delay) infinite, sway .7s var(--ease); }
  @keyframes sway { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(8deg); } 55% { transform: rotate(-6deg); } 80% { transform: rotate(2deg); } }

  .bubble {
    position: absolute;
    bottom: 100%;
    left: 58%;
    margin-bottom: 2px;
    padding: 3px 9px 4px;
    border: 1.5px solid var(--electric);
    border-radius: 999px 999px 999px 4px;
    background: var(--bg);
    color: var(--electric);
    font-family: var(--display);
    font-weight: 500;
    font-size: 15px;
    line-height: 1.1;
    white-space: nowrap;
    opacity: 0;
    transform-origin: 0 100%;
  }
  /* bubble opens toward the middle so it never pokes past the edges */
  .dog.bl .bubble { left: auto; right: 58%; border-radius: 999px 999px 4px 999px; transform-origin: 100% 100%; }
  .dog.woof .bubble { animation: woof 1.1s var(--ease) both; }
  @keyframes woof {
    0% { opacity: 0; transform: scale(.4) translateY(6px); }
    15% { opacity: 1; transform: scale(1.08); }
    25%, 70% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: translateY(-6px); }
  }

  /* hearts are created by the script, so they need :global */
  .pup :global(.heart) {
    position: absolute;
    bottom: 66px;
    color: #ff4d8d;
    font-size: 14px;
    line-height: 1;
    pointer-events: none;
    animation: float 1.3s var(--ease) forwards;
  }
  @keyframes float {
    0% { opacity: 0; transform: translate(0, 0) scale(.5); }
    15% { opacity: 1; transform: translate(0, -6px) scale(1); }
    100% { opacity: 0; transform: translate(var(--dx), -54px) scale(.9) rotate(var(--r)); }
  }

  /* reduced motion: the dog stays put; the bubble and hearts only fade (beats the global kill switch) */
  @media (prefers-reduced-motion: reduce) {
    .bob, .sprite, .zzz i, .flower { animation: none !important; }
    .zzz i { opacity: 1; }
    .zzz i:nth-child(2) { transform: translate(6px, -14px); }
    .zzz i:nth-child(3) { transform: translate(12px, -28px); }
    .flower { background-position: -54px calc(var(--row) * -36px); }
    .dog.woof .bubble { animation: fade 1.1s linear both !important; }
    .pup :global(.heart) { animation: fade 1.3s linear forwards !important; }
    @keyframes fade { 0%, 100% { opacity: 0; } 15%, 60% { opacity: 1; } }
  }
</style>

<script>
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const F = { stand: 0, sit: 1, crouch: 2, sleep: 3, breath: 4, roll: 5, side: 7, run: 8 };
  const RUN_FRAMES = 8;
  const STRIDE = 16; // css px of travel per run frame

  // restart a one-shot animation class
  function replay(el: HTMLElement, cls: string) {
    el.classList.remove(cls);
    void el.offsetWidth;
    el.classList.add(cls);
  }

  const easeInOut = (t: number) => 0.5 - Math.cos(Math.PI * t) / 2;

  function mount(root: HTMLElement) {
    if (root.dataset.bound) return;
    root.dataset.bound = '1';
    const dog = root.querySelector<HTMLElement>('.dog')!;
    const sprite = root.querySelector<HTMLElement>('.sprite')!;
    const flowers = [...root.querySelectorAll<HTMLElement>('.flower')];
    let x = 8;
    let run = 0; // token so a retargeted run cancels the old one
    const timers = new Set<number>();
    let breath = 0;

    const bob = root.querySelector<HTMLElement>('.bob')!;
    const lean = (deg: number, sx = 1, sy = 1) => { bob.style.transform = deg || sx !== 1 || sy !== 1 ? `rotate(${deg}deg) scale(${sx}, ${sy})` : ''; };
    const frame = (n: number) => sprite.style.setProperty('--f', String(n));
    const later = (fn: () => void, ms: number) => {
      const id = window.setTimeout(() => { timers.delete(id); fn(); }, ms);
      timers.add(id);
    };
    const clearTimers = () => { timers.forEach(clearTimeout); timers.clear(); };
    const pose = (...on: string[]) => {
      dog.classList.remove('asleep', 'stand', 'perk', 'hop');
      on.forEach((c) => dog.classList.add(c));
    };

    // where the dog actually is right now, even mid-run
    const currentX = () => new DOMMatrixReadOnly(getComputedStyle(dog).transform).m41 || x;
    const place = (px: number) => { x = px; dog.style.transform = `translateX(${px}px)`; };
    const faceTowards = (to: number, from: number) => { if (Math.abs(to - from) > 2) dog.classList.toggle('left', to < from); };

    // asleep: two-frame breathing, slow enough to read as deep sleep
    function sleep() {
      clearTimers();
      clearInterval(breath);
      pose('asleep');
      dog.classList.remove('bl');
      let inhale = false;
      frame(F.sleep);
      if (reduce()) return;
      breath = window.setInterval(() => { inhale = !inhale; frame(inhale ? F.breath : F.sleep); }, 1400);
    }

    // after a few quiet seconds he winds down: sit, then curl up again
    function windDown() {
      later(() => {
        pose();
        frame(F.sit);
        later(sleep, 1800);
      }, 5000);
    }

    function hearts() {
      const facingLeft = dog.classList.contains('left');
      const headX = x + (facingLeft ? 14 : dog.offsetWidth - 14);
      const n = 3 + Math.floor(Math.random() * 3);
      for (let i = 0; i < n; i++) {
        const h = document.createElement('span');
        h.className = 'heart';
        h.textContent = '♥';
        h.setAttribute('aria-hidden', 'true');
        h.style.left = `${headX + (Math.random() - 0.5) * 24}px`;
        h.style.setProperty('--dx', `${(Math.random() - 0.5) * 36}px`);
        h.style.setProperty('--r', `${(Math.random() - 0.5) * 40}deg`);
        h.style.animationDelay = `${i * 70}ms`;
        h.style.fontSize = `${11 + Math.random() * 7}px`;
        root.appendChild(h);
        setTimeout(() => h.remove(), 1400 + i * 70);
      }
    }

    // a flower sways when the dog's body passes over it
    const brushed = new WeakMap<HTMLElement, number>();
    function brush(px: number) {
      const centre = px + dog.offsetWidth / 2;
      const w = root.clientWidth;
      const now = performance.now();
      for (const f of flowers) {
        const fx = (parseFloat(f.style.left) / 100) * w;
        if (Math.abs(fx - centre) < 44 && now - (brushed.get(f) ?? -1e4) > 900) {
          brushed.set(f, now);
          replay(f, 'sway');
        }
      }
    }

    function roll(left: number) {
      if (left <= 0) { frame(F.stand); pose('stand'); windDown(); return; }
      frame(left % 2 ? F.roll : F.roll + 1);
      later(() => roll(left - 1), 170);
    }

    function arrive() {
      dog.classList.toggle('bl', x + dog.offsetWidth / 2 > root.clientWidth / 2);
      frame(F.stand);
      if (reduce()) { pose('stand'); replay(dog, 'woof'); hearts(); later(sleep, 2600); return; }
      pose('stand');
      replay(dog, 'hop');
      replay(dog, 'woof');
      hearts();
      // sometimes he can't help rolling over for a belly rub
      if (Math.random() < 0.45) {
        later(() => { pose(); frame(F.side); later(() => roll(7), 160); }, 700);
      } else {
        windDown();
      }
    }

    // sprint to `to`, easing in and out; leg turnover follows the speed
    function runTo(to: number) {
      const id = ++run;
      const from = currentX();
      faceTowards(to, from);
      const dist = Math.abs(to - from);
      if (dist < 6) { place(to); lean(0); arrive(); return; }
      const dur = Math.min(2200, Math.max(600, 500 + dist * 3));
      const dir = to > from ? 1 : -1;
      pose();
      dog.style.transition = 'none';
      let start = 0, last = 0, phase = 0;
      const step = (now: number) => {
        if (id !== run) return;
        if (!start) start = last = now;
        const t = Math.min(1, (now - start) / dur);
        const px = from + (to - from) * easeInOut(t);
        const v = Math.abs(px - x); // px moved this frame
        const dt = Math.max(1, now - last);
        place(px);
        phase += v / STRIDE;
        if (t < 0.9) {
          frame(F.run + (Math.floor(phase) % RUN_FRAMES));
          // lean into the sprint (follow-through), stretching a touch with speed
          const sp = Math.min(1, (v / dt) * 16 / 6);
          lean(sp * 5, 1 + sp * 0.04, 1 - sp * 0.03);
        } else {
          frame(F.stand); // legs stop pumping: he plants, rocks back on his heels, then settles
          lean(-4 * (1 - (t - 0.9) / 0.1), 1.03, 0.97);
        }
        brush(px);
        last = now;
        if (t < 1) requestAnimationFrame(step);
        else { place(to); lean(0); arrive(); }
      };
      requestAnimationFrame(step);
    }

    sleep();

    root.addEventListener('click', (e) => {
      root.classList.add('played');
      clearTimers();
      clearInterval(breath);
      const wasAsleep = dog.classList.contains('asleep');

      const max = Math.max(0, root.clientWidth - dog.offsetWidth);
      const from = currentX();
      let to: number;
      if (e.detail > 0) {
        to = e.clientX - root.getBoundingClientRect().left - dog.offsetWidth / 2;
      } else {
        do { to = Math.random() * max; } while (max > 120 && Math.abs(to - from) < 60);
      }
      to = Math.min(max, Math.max(0, to));

      if (reduce()) { run++; faceTowards(to, from); arrive(); return; }

      ++run; // cancel any run in flight
      lean(0);
      faceTowards(to, from);
      if (wasAsleep) {
        // anticipation: ears up, a quick crouch, then go
        pose('perk');
        frame(F.crouch);
        later(() => runTo(to), 300);
      } else {
        runTo(to);
      }
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.pup').forEach(mount);
  });
</script>
